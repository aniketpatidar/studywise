<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "Studywise" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <style>
      @media (min-width: 640px) {
        [data-mobile-nav-toggle] {
          display: none !important;
        }

        [data-mobile-nav-menu] {
          display: none !important;
        }
      }
    </style>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased text-slate-900 bg-slate-50">
    <div class="min-h-screen flex flex-col">
      
      <header class="relative z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4" data-controller="mobile-menu">
          <div class="flex items-center gap-3">
            <%= link_to(user_signed_in? ? materials_path : root_path, class: "flex items-center gap-2") do %>
              <div class="h-8 w-8 rounded-xl bg-slate-900 text-slate-50 flex items-center justify-center text-xs font-semibold tracking-[0.16em] uppercase">
                Sw
              </div>
              <div class="hidden sm:block">
                <p class="text-[10px] font-semibold tracking-[0.24em] uppercase text-slate-400">Studywise</p>
              </div>
            <% end %>
          </div>

          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
            <% if user_signed_in? %>
              <%= link_to "Library", materials_path, class: "hover:text-slate-900 #{current_page?(materials_path) ? 'text-slate-900' : ''}" %>
              <%= link_to "Tutors", subject_chats_path, class: "hover:text-slate-900 #{current_page?(subject_chats_path) ? 'text-slate-900' : ''}" %>
            <% else %>
              <%= link_to "How it works", root_path(anchor: "how-it-works"), class: "hover:text-slate-900" %>
              <%= link_to "Features", root_path(anchor: "features"), class: "hover:text-slate-900" %>
            <% end %>
          </nav>

          <div class="flex items-center gap-2">
            <% if user_signed_in? %>
              <%= link_to new_material_path, class: "hidden sm:inline-flex items-center justify-center rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900" do %>
                New material
              <% end %>
              <button type="button" class="inline-flex sm:hidden items-center justify-center rounded-full border border-slate-200 p-2 text-slate-700 hover:border-slate-900 hover:text-slate-900" data-action="mobile-menu#toggle" data-mobile-nav-toggle aria-label="Open menu">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M3 5h14v2H3V5zm0 4h14v2H3V9zm0 4h14v2H3v-2z" />
                </svg>
              </button>
              <div class="relative hidden sm:block z-[80] pointer-events-auto" data-controller="profile-dropdown">
                <button
                  type="button"
                  data-action="profile-dropdown#toggle"
                  aria-haspopup="true"
                  aria-expanded="false"
                  class="h-8 w-8 rounded-full bg-slate-900 text-slate-50 flex items-center justify-center text-xs font-semibold uppercase tracking-[0.3em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-slate-900"
                >
                  <%= (current_user.name || "").first&.upcase %>
                </button>
                <div
                  data-profile-dropdown-target="menu"
                  class="hidden absolute right-0 mt-2 w-44 min-w-[160px] rounded-2xl border border-slate-200 bg-white shadow-lg py-1 z-[90] pointer-events-auto"
                >
                  <div class="space-y-1">
                    <% if current_user.admin? %>
                      <%= link_to "Admin", admin_path, class: "block px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900" %>
                    <% end %>
                    <%= link_to "Log out", logout_path, method: :delete, data: { turbo_method: :delete }, class: "block px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900" %>
                  </div>
                </div>
              </div>
            <% else %>
              <%= link_to "Sign in", login_path, class: "hidden sm:inline-flex items-center justify-center rounded-full px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900" %>
              <%= link_to "Create account", signup_path, class: "inline-flex items-center justify-center rounded-full bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-slate-50 hover:bg-black" %>
            <% end %>
          </div>

          <% if user_signed_in? %>
            <div data-mobile-menu-target="menu" data-mobile-nav-menu class="hidden sm:hidden absolute z-40 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl" style="right: 1rem; top: calc(100% + 0.5rem);">
              <div class="space-y-1 text-sm font-medium text-slate-700">
                <%= link_to "Library", materials_path, class: "block rounded-xl px-3 py-2 hover:bg-slate-50 hover:text-slate-900", data: { action: "click->mobile-menu#close" } %>
                <%= link_to "Tutors", subject_chats_path, class: "block rounded-xl px-3 py-2 hover:bg-slate-50 hover:text-slate-900", data: { action: "click->mobile-menu#close" } %>
                <%= link_to "New material", new_material_path, class: "block rounded-xl px-3 py-2 hover:bg-slate-50 hover:text-slate-900", data: { action: "click->mobile-menu#close" } %>
              </div>
              <div class="mt-2 border-t border-slate-200 pt-2">
                <%= button_to "Log out", logout_path, method: :delete, class: "w-full rounded-xl px-3 py-2 text-left text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 bg-white border border-transparent" %>
              </div>
            </div>
          <% end %>
        </div>
      </header>

      
      <main class="flex-1 py-8 sm:py-10">
        <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="pointer-events-none absolute top-0 left-1/2 z-40 flex w-full max-w-md -translate-x-1/2 flex-col gap-2">
            <% if notice.present? %>
              <div data-toast class="pointer-events-auto rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-xl" style="border-left: 4px solid #10b981;">
                <%= notice %>
              </div>
            <% end %>
            <% if alert.present? %>
              <div data-toast class="pointer-events-auto rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-xl" style="border-left: 4px solid #f43f5e;">
                <%= alert %>
              </div>
            <% end %>
          </div>
          <%= yield %>
        </div>
      </main>

      
      <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500">
          <p>&copy; <%= Time.current.year %> Studywise. Built for focused studying.</p>
          <div class="flex gap-4">
            <a href="#" class="hover:text-slate-900">Status</a>
            <a href="#" class="hover:text-slate-900">Terms</a>
            <a href="#" class="hover:text-slate-900">Privacy</a>
          </div>
        </div>
      </footer>
    </div>
    <script>
      (function() {
        const toasts = document.querySelectorAll("[data-toast]");
        toasts.forEach((toast) => {
          setTimeout(() => {
            toast.style.transition = "opacity 200ms ease";
            toast.style.opacity = "0";
            setTimeout(() => toast.remove(), 220);
          }, 5000);
        });
      })();
    </script>
  </body>
</html>
