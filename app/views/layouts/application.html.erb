<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "Studywise" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased text-slate-900 bg-slate-50">
    <div class="min-h-screen flex flex-col">
      
      <header class="border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2" do %>
              <div class="h-8 w-8 rounded-xl bg-slate-900 text-slate-50 flex items-center justify-center text-xs font-semibold tracking-[0.16em] uppercase">
                Sw
              </div>
              <div class="hidden sm:block">
                <p class="text-[10px] font-semibold tracking-[0.24em] uppercase text-slate-400">Studywise</p>
              </div>
            <% end %>
          </div>

          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
            <% if user_signed_in? %>
              <%= link_to "Dashboard", root_path, class: "hover:text-slate-900 #{current_page?(root_path) ? 'text-slate-900' : ''}" %>
              <%= link_to "Library", materials_path, class: "hover:text-slate-900 #{current_page?(materials_path) ? 'text-slate-900' : ''}" %>
              <%= link_to "Tutors", subject_chats_path, class: "hover:text-slate-900 #{current_page?(subject_chats_path) ? 'text-slate-900' : ''}" %>
            <% else %>
              <%= link_to "How it works", "#", class: "hover:text-slate-900" %>
              <%= link_to "Pricing", "#", class: "hover:text-slate-900" %>
            <% end %>
          </nav>

          <div class="flex items-center gap-2">
            <% if user_signed_in? %>
              <%= link_to new_material_path, class: "hidden sm:inline-flex items-center justify-center rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900" do %>
                New material
              <% end %>
              <div class="h-8 w-8 rounded-full bg-slate-900 text-slate-50 flex items-center justify-center text-xs font-semibold">
                <%= (current_user.name || "").first&.upcase %>
              </div>
            <% else %>
              <%= link_to "Sign in", login_path, class: "hidden sm:inline-flex items-center justify-center rounded-full px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900" %>
              <%= link_to "Create account", signup_path, class: "inline-flex items-center justify-center rounded-full bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-slate-50 hover:bg-black" %>
            <% end %>
          </div>
        </div>
      </header>

      
      <main class="flex-1 py-8 sm:py-10">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <% if notice.present? %>
            <div class="mb-6 rounded-xl border border-emerald-100 bg-emerald-50 text-emerald-800 px-4 py-3 text-sm font-medium"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="mb-6 rounded-xl border border-rose-100 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-medium"><%= alert %></div>
          <% end %>

          <%= yield %>
        </div>
      </main>

      
      <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500">
          <p>&copy; <%= Time.current.year %> Studywise. Built for focused studying.</p>
          <div class="flex gap-4">
            <a href="#" class="hover:text-slate-900">Status</a>
            <a href="#" class="hover:text-slate-900">Terms</a>
            <a href="#" class="hover:text-slate-900">Privacy</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
