<% content_for :title, "#{@quiz.title} | StudyWISE" %>

<div class="max-w-4xl mx-auto pb-20">
  <header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center rounded-full bg-[#111113] px-2.5 py-1 text-[10px] font-medium border border-[#1f2937] uppercase tracking-wider" style="color: #e2e8f0;">Quiz Session</span>
        <span class="text-[10px] font-medium uppercase tracking-wider" style="color: #94a3b8;"><%= @quiz.generation_mode %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight"><%= @quiz.title %></h1>
    </div>
    <div class="flex-shrink-0">
      <%= link_to material_path(@material), class: "inline-flex items-center justify-center gap-2 rounded-full border border-[#1f2937] px-4 py-2 text-xs font-semibold hover:border-[#bef264] hover:text-[#bef264] bg-[#09090b] transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Abort Quiz</span>
      <% end %>
    </div>
  </header>

  <div class="space-y-8">
    <% if @latest_attempt.blank? %>
      <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-6 sm:p-8 shadow-lg">
        <%= form_with url: submit_material_quiz_path(@material, @quiz), method: :post, class: "space-y-8" do |f| %>
          <% @quiz.questions.each_with_index do |q, idx| %>
            <fieldset class="space-y-4">
              <legend class="text-base sm:text-lg font-semibold text-white flex gap-3 leading-snug">
                <span class="flex-shrink-0" style="color: #94a3b8;"><%= idx + 1 %>.</span>
                <span><%= q["question"] %></span>
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <% Array(q["options"]).each_with_index do |option, opt_idx| %>
                  <label class="group relative flex items-center p-4 border border-[#1f2937] rounded-xl cursor-pointer transition-all hover:border-[#bef264]/40 hover:bg-[#111113] has-[:checked]:border-[#bef264] has-[:checked]:bg-[#111113] has-[:checked]:ring-2 has-[:checked]:ring-[#bef264]/20">
                    <div class="flex items-center gap-3">
                      <%= radio_button_tag "answers[#{idx}]", opt_idx, false, required: true, class: "w-4 h-4 text-[#bef264] border-[#374151] focus:ring-[#bef264] transition-all cursor-pointer" %>
                      <span class="text-sm font-medium transition-colors leading-tight" style="color: #e2e8f0;"><%= option %></span>
                    </div>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>

          <div class="pt-6 border-t border-[#1f2937]">
            <%= f.submit "Complete Analysis",
                class: "w-full py-3 bg-[#bef264] text-black rounded-full font-semibold text-xs tracking-tight hover:bg-[#a3e635] transition-all cursor-pointer shadow-[0_0_24px_rgba(190,242,100,0.3)]"
            %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @latest_attempt.present? %>
      <div id="results" class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-6 sm:p-8 shadow-lg">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-8">
          <div>
            <h2 class="text-lg font-semibold text-white">Performance Summary</h2>
            <div class="flex items-center gap-2 mt-1">
               <span class="w-1.5 h-1.5 bg-[#bef264] rounded-full"></span>
               <span class="text-[10px] font-medium uppercase tracking-wider" style="color: #94a3b8;">Analysis Complete</span>
            </div>
          </div>
          <div class="flex items-baseline gap-1.5 bg-[#111113] px-5 py-3 rounded-xl border border-[#1f2937] shadow-sm self-start sm:self-auto">
            <div class="text-2xl font-semibold text-white"><%= @latest_attempt.score %></div>
            <div class="text-sm font-medium" style="color: #94a3b8;">/ <%= @latest_attempt.total %></div>
          </div>
        </div>

        <div class="space-y-6">
          <% Array(@quiz.questions).each_with_index do |question, idx| %>
            <% review = @latest_attempt.answers[idx.to_s] || {} %>
            <div class="bg-[#111113] border <%= review["correct"] ? 'border-emerald-500/30' : 'border-rose-500/30' %> rounded-xl p-5 sm:p-6">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
                <h3 class="text-sm font-semibold text-white leading-snug">Q<%= idx + 1 %>. <%= review["question"] || question["question"] %></h3>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-medium uppercase tracking-wider whitespace-nowrap self-start <%= review["correct"] ? 'bg-emerald-500/10 border border-emerald-500/30' : 'bg-rose-500/10 border border-rose-500/30' %>" style="<%= review["correct"] ? 'color: #bbf7d0;' : 'color: #fca5a5;' %>">
                  <%= review["correct"] ? "Precise" : "Correction Needed" %>
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                <div class="p-4 <%= review["correct"] ? 'bg-emerald-500/5' : 'bg-rose-500/5' %> rounded-xl border border-[#1f2937]">
                  <p class="text-[9px] font-medium uppercase tracking-wider mb-1.5" style="color: #94a3b8;">Selected Choice</p>
                  <p class="text-xs font-semibold leading-tight" style="color: #e2e8f0;"><%= Array(question["options"])[review["selected_index"].to_i] || "No response" %></p>
                </div>
                <div class="p-4 bg-emerald-500/10 rounded-xl border border-emerald-500/30">
                  <p class="text-[9px] font-medium uppercase tracking-wider mb-1.5" style="color: #bbf7d0;">Verified Expert Answer</p>
                  <p class="text-xs font-semibold leading-tight" style="color: #bbf7d0;"><%= Array(question["options"])[review["correct_index"].to_i] || "Verified Source" %></p>
                </div>
              </div>

              <% if review["explanation"].present? %>
                <div class="p-4 bg-[#09090b] border border-[#1f2937] rounded-xl">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-medium uppercase tracking-wider" style="color: #94a3b8;">Expert Explanation</span>
                  </div>
                  <p class="text-xs font-medium leading-relaxed" style="color: #94a3b8;"><%= review["explanation"] %></p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
