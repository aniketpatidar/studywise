<% content_for :title, "#{@quiz.title} | StudyWISE" %>

<div class="max-w-4xl mx-auto pb-20">
  <header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-medium text-slate-600 border border-slate-200 uppercase tracking-wider">Quiz Session</span>
        <span class="text-[10px] font-medium uppercase text-slate-500 tracking-wider"><%= @quiz.generation_mode %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight"><%= @quiz.title %></h1>
    </div>
    <div class="flex-shrink-0">
      <%= link_to material_path(@material), class: "inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Abort Quiz</span>
      <% end %>
    </div>
  </header>

  <div class="space-y-8">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
      <%= form_with url: submit_material_quiz_path(@material, @quiz), method: :post, class: "space-y-8" do |f| %>
        <% @quiz.questions.each_with_index do |q, idx| %>
          <fieldset class="space-y-4">
            <legend class="text-base sm:text-lg font-semibold text-slate-900 flex gap-3 leading-snug">
              <span class="text-slate-400 flex-shrink-0"><%= idx + 1 %>.</span>
              <span><%= q["question"] %></span>
            </legend>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% Array(q["options"]).each_with_index do |option, opt_idx| %>
                <label class="group relative flex items-center p-4 border border-slate-200 rounded-xl cursor-pointer transition-all hover:border-slate-400 hover:bg-slate-50 has-[:checked]:border-slate-900 has-[:checked]:bg-slate-50 has-[:checked]:ring-2 has-[:checked]:ring-slate-900/5">
                  <div class="flex items-center gap-3">
                    <%= radio_button_tag "answers[#{idx}]", opt_idx, false, required: true, class: "w-4 h-4 text-slate-900 border-slate-300 focus:ring-slate-900 transition-all cursor-pointer" %>
                    <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 transition-colors leading-tight"><%= option %></span>
                  </div>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% end %>
        
        <div class="pt-6 border-t border-slate-200">
          <%= f.submit "Complete Analysis", 
              class: "w-full py-3 bg-slate-900 text-white rounded-full font-semibold text-xs tracking-tight hover:bg-black transition-all cursor-pointer" 
          %>
        </div>
      <% end %>
    </div>

    <% if @latest_attempt.present? %>
      <div id="results" class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-8">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Performance Summary</h2>
            <div class="flex items-center gap-2 mt-1">
               <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
               <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">Analysis Complete</span>
            </div>
          </div>
          <div class="flex items-baseline gap-1.5 bg-white px-5 py-3 rounded-xl border border-slate-200 shadow-sm self-start sm:self-auto">
            <div class="text-2xl font-semibold text-slate-900"><%= @latest_attempt.score %></div>
            <div class="text-sm font-medium text-slate-400">/ <%= @latest_attempt.total %></div>
          </div>
        </div>

        <div class="space-y-6">
          <% Array(@quiz.questions).each_with_index do |question, idx| %>
            <% review = @latest_attempt.answers[idx.to_s] || {} %>
            <div class="bg-white border <%= review["correct"] ? 'border-emerald-100 shadow-sm shadow-emerald-50/50' : 'border-rose-100 shadow-sm shadow-rose-50/50' %> rounded-xl p-5 sm:p-6">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
                <h3 class="text-sm font-semibold text-slate-900 leading-snug">Q<%= idx + 1 %>. <%= review["question"] || question["question"] %></h3>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-medium uppercase tracking-wider whitespace-nowrap self-start <%= review["correct"] ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                  <%= review["correct"] ? "Precise" : "Correction Needed" %>
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                <div class="p-4 <%= review["correct"] ? 'bg-emerald-50/30' : 'bg-rose-50/30' %> rounded-xl border border-slate-100 text-slate-400">
                  <p class="text-[9px] font-medium uppercase tracking-wider mb-1.5">Selected Choice</p>
                  <p class="text-xs font-semibold text-slate-900 leading-tight"><%= Array(question["options"])[review["selected_index"].to_i] || "No response" %></p>
                </div>
                <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-100">
                  <p class="text-[9px] font-medium uppercase text-emerald-600 tracking-wider mb-1.5">Verified Expert Answer</p>
                  <p class="text-xs font-semibold text-emerald-900 leading-tight"><%= Array(question["options"])[review["correct_index"].to_i] || "Verified Source" %></p>
                </div>
              </div>

              <% if review["explanation"].present? %>
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-medium uppercase text-slate-500 tracking-wider">Expert Explanation</span>
                  </div>
                  <p class="text-xs font-medium text-slate-600 leading-relaxed"><%= review["explanation"] %></p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
