<section class="relative overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 to-white px-6 py-12 sm:px-10 sm:py-16">
  <div class="absolute -top-10 left-1/2 h-36 w-36 -translate-x-1/2 rounded-full bg-sky-200/40 blur-3xl"></div>

  <div class="relative mx-auto max-w-4xl text-center">
    <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-500">Studywise</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-5xl">
      Every answer, verified from your material.
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
      Upload notes, PDFs, or YouTube lectures and move from messy content to structured notes, quizzes, and source-grounded tutor chat.
    </p>

  </div>

  <div class="relative mx-auto mt-10 max-w-3xl rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <p class="text-xs font-semibold text-slate-900">Study Chat Preview</p>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600">Grounded</span>
    </div>

    <div class="mt-4 space-y-3">
      <div class="ml-auto max-w-[82%] rounded-2xl rounded-br-sm bg-slate-900 px-3 py-2 text-xs font-medium text-white">
        Explain photosynthesis in simple terms.
      </div>
      <div class="max-w-[88%] rounded-2xl rounded-bl-sm border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700">
        Photosynthesis converts light into glucose. Plants absorb sunlight, use water and carbon dioxide, and release oxygen.
        <div class="mt-2 rounded-lg border border-slate-200 bg-white px-2 py-1 text-[10px] text-slate-500">
          Source: "6CO2 + 6H2O + light -&gt; C6H12O6 + 6O2"
        </div>
      </div>
    </div>
  </div>

  <div class="relative mx-auto mt-8 grid max-w-4xl gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center">
      <p class="text-xl font-black text-slate-900">50k+</p>
      <p class="text-[11px] text-slate-500">Source lines processed</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center">
      <p class="text-xl font-black text-slate-900">0%</p>
      <p class="text-[11px] text-slate-500">Hallucination goal bias</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center">
      <p class="text-xl font-black text-slate-900">3 steps</p>
      <p class="text-[11px] text-slate-500">From upload to quiz</p>
    </div>
  </div>
</section>

<section id="features" class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <div class="flex items-end justify-between gap-3">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Why It Works</p>
      <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900">Control access. Keep Q&amp;A trusted.</h2>
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Source-aware notes</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Generate structured summaries, key concepts, and practice questions from your uploaded material.</p>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Verified chat replies</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Study chat keeps context budgeted and appends citation snippets from extracted source text.</p>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Assessment loops</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Generate 5-question quizzes, submit answers, and use results to guide follow-up tutoring.</p>
    </article>
  </div>
</section>

<section id="how-it-works" class="mt-10">
  <div class="rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 to-white p-6 sm:p-8">
    <h2 class="text-2xl font-black tracking-tight text-slate-900">From transcript to verified answer in three steps</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">Step 1</p>
        <p class="mt-2 text-base font-bold text-slate-900">Upload material</p>
        <p class="mt-1 text-xs text-slate-600">Text, PDF, DOCX, PPTX, or a YouTube link.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">Step 2</p>
        <p class="mt-2 text-base font-bold text-slate-900">Generate note + quiz</p>
        <p class="mt-1 text-xs text-slate-600">Create study notes and exact 5-question MCQ checks.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">Step 3</p>
        <p class="mt-2 text-base font-bold text-slate-900">Ask with citations</p>
        <p class="mt-1 text-xs text-slate-600">Use study chat with memory controls and source-grounded responses.</p>
      </article>
    </div>
  </div>
</section>

<section class="mt-10 rounded-3xl border border-slate-200 bg-slate-900 px-6 py-10 text-center text-white sm:px-8">
  <h2 class="text-2xl font-black tracking-tight">Your course. Every answer verified from the transcript.</h2>
  <p class="mx-auto mt-2 max-w-2xl text-sm text-slate-300">Start with one sample material and see notes, quiz, and chat flow in minutes.</p>
  <div class="mt-6">
    <%= link_to "Start now", signup_path, class: "inline-flex items-center justify-center rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100" %>
  </div>
</section>
