<% content_for :title, "Sign in | StudyWISE" %>

<div class="flex flex-col items-center justify-center px-4 pb-20 bg-slate-50/30">
  <div class="w-full max-w-md sm:max-w-xl">
    <div class="text-center mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2 tracking-tight">Welcome back</h1>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-sm relative overflow-hidden">
      <%= form_with url: login_path, class: "relative z-10 space-y-6" do |f| %>
        <div class="space-y-2">
          <%= f.label :email, class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
          <%= f.email_field :email, required: true, 
              placeholder: "you@example.com",
              class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between pl-1">
            <%= f.label :password, class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider" %>
          </div>
          <%= f.password_field :password, required: true, 
              placeholder: "Enter your password",
              class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="pt-4">
          <%= f.submit "Sign into StudyWISE", 
              class: "w-full py-3 bg-slate-900 text-white rounded-full font-semibold text-[13px] tracking-tight hover:bg-black transition-all shadow-sm cursor-pointer" 
          %>
        </div>
      <% end %>

      <% if google_oauth_enabled? %>
        <div class="relative z-10 my-6 flex items-center">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="px-3 text-[10px] font-semibold uppercase tracking-wider text-slate-500">or</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>
        <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "relative z-10 w-full inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-white py-3 text-[13px] font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 transition-all shadow-sm" do %>
          <span>Continue with Google</span>
        <% end %>
      <% end %>
    </div>

    <p class="mt-8 text-center text-sm font-medium text-slate-500">
      New to StudyWISE? 
      <%= link_to "Create a free account", signup_path, class: "text-slate-900 font-semibold hover:underline ml-1" %>
    </p>
  </div>
</div>
