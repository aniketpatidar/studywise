<% content_for :title, "Sign in | StudyWISE" %>

<div class="min-h-[calc(100vh-12rem)] flex flex-col items-center justify-center p-6 pb-20">
  <div class="w-full max-w-lg">
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-[#6C5DD3]/10 text-[#6C5DD3] rounded-[24px] sm:rounded-[32px] mb-6 sm:mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#2D2E32] mb-3 tracking-tight">Welcome back</h1>
      <p class="text-[#6C6D70] font-medium leading-relaxed max-w-xs mx-auto text-sm sm:text-base">Sign in to continue your StudyWISE learning journey.</p>
    </div>

    <div class="bg-white border border-[#E8E9EB] rounded-[40px] sm:rounded-[48px] p-8 sm:p-14 shadow-2xl shadow-indigo-100/40 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-[#6C5DD3]/5 rounded-full -mr-32 -mt-32 blur-3xl opacity-60"></div>
      
      <%= form_with url: login_path, class: "relative z-10 space-y-6" do |f| %>
        <div class="space-y-2.5">
          <%= f.label :email, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
          <%= f.email_field :email, required: true, 
              placeholder: "email@example.com",
              class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="space-y-2.5">
          <div class="flex items-center justify-between pl-1">
            <%= f.label :password, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest" %>
          </div>
          <%= f.password_field :password, required: true, 
              placeholder: "••••••••",
              class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="pt-6">
          <%= f.submit "Sign into account", 
              class: "w-full py-5 bg-[#6C5DD3] text-white rounded-[20px] font-black text-sm tracking-tight hover:bg-[#5849C4] hover:-translate-y-1 transition-all shadow-2xl shadow-indigo-100 cursor-pointer" 
          %>
        </div>
      <% end %>
    </div>

    <p class="mt-8 text-center text-sm font-medium text-[#6C6D70]">
      New to StudyWISE? 
      <%= link_to "Create a free account", signup_path, class: "text-[#6C5DD3] font-black hover:underline ml-1" %>
    </p>
  </div>
</div>
