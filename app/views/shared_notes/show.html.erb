<% content_for :title, "Shared Note | StudyWISE" %>

<div class="min-h-screen bg-slate-50/30 py-16 sm:py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-center gap-2 mb-12 sm:mb-16">
      <div class="w-8 h-8 bg-slate-900 rounded-lg flex items-center justify-center text-white text-base shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18 18.246 18.477 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <span class="text-lg font-semibold text-slate-900 tracking-tight">StudyWISE</span>
    </div>

    <header class="mb-12 sm:mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-slate-200 rounded-full mb-6">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
        <span class="text-[10px] font-semibold uppercase text-slate-500 tracking-wider">Shared Study Insights</span>
      </div>
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-semibold text-slate-900 tracking-tight mb-4 sm:mb-6 leading-tight"><%= @note.title %></h1>
      <p class="text-slate-600 font-medium text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">Original Material: <span class="text-slate-900 font-semibold underline decoration-slate-200 decoration-2 underline-offset-4"><%= @material.title %></span></p>
      
      <div class="flex items-center justify-center gap-4 sm:gap-6 mt-8 sm:mt-10">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 bg-slate-100 rounded-full flex items-center justify-center text-slate-500 border border-slate-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="text-[10px] font-semibold text-slate-900 uppercase tracking-wider">StudyWISE AI</span>
        </div>
        <div class="w-1 h-1 bg-slate-200 rounded-full"></div>
        <time class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider"><%= @note.created_at.strftime("%B %d, %Y") %></time>
      </div>
    </header>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 md:p-16 shadow-sm relative overflow-hidden">
      <div class="relative z-10">
        <div class="prose prose-slate prose-sm sm:prose-base md:prose-lg max-w-none prose-headings:font-bold prose-p:text-slate-600 prose-p:leading-relaxed prose-strong:text-slate-900 prose-ul:list-disc prose-li:text-slate-600">
          <%= @note.content %>
        </div>

        <div class="mt-12 sm:mt-16 pt-8 sm:pt-12 border-t border-slate-200">
          <h3 class="text-[10px] font-semibold uppercase text-slate-500 tracking-wider mb-4">Mastered Concepts</h3>
          <div class="flex flex-wrap gap-2">
            <% Array(@note.key_concepts).each do |concept| %>
              <span class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-full text-[11px] font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 transition-all cursor-default">
                <%= concept %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 sm:mt-20 text-center">
      <h2 class="text-xl sm:text-2xl font-semibold text-slate-900 mb-4 sm:mb-6">Want to generate your own study insights?</h2>
      <%= link_to root_path, class: "inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-full font-semibold text-xs tracking-tight hover:bg-black transition-all shadow-sm" do %>
        <span>Join StudyWISE Today</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
