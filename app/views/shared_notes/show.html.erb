<% content_for :title, "Shared Note | StudyWISE" %>

<div class="min-h-screen bg-[#FDFDFD] py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-center gap-3 mb-16">
      <div class="w-10 h-10 bg-[#6C5DD3] rounded-2xl flex items-center justify-center text-white text-lg shadow-lg shadow-indigo-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18 18.246 18.477 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <span class="text-xl font-black text-[#2D2E32] tracking-tight">StudyWISE</span>
    </div>

    <header class="mb-16 text-center">
      <div class="inline-flex items-center gap-3 px-4 py-1.5 bg-[#6C5DD3]/5 rounded-full mb-6">
        <span class="w-2 h-2 bg-[#6C5DD3] rounded-full animate-pulse"></span>
        <span class="text-[10px] font-black uppercase text-[#6C6D70] tracking-widest">Shared Study Insights</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-[#2D2E32] tracking-tight mb-6 leading-tight"><%= @note.title %></h1>
      <p class="text-[#6C6D70] font-medium text-lg leading-relaxed max-w-2xl mx-auto">Original Material: <span class="text-[#2D2E32] font-bold underline decoration-indigo-100 decoration-4 underline-offset-4"><%= @material.title %></span></p>
      
      <div class="flex items-center justify-center gap-6 mt-10">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center text-[#6C6D70]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#2D2E32]">StudyWISE AI</span>
        </div>
        <div class="w-1.5 h-1.5 bg-[#E8E9EB] rounded-full"></div>
        <time class="text-xs font-bold text-[#6C6D70] uppercase tracking-widest"><%= @note.created_at.strftime("%B %d, %Y") %></time>
      </div>
    </header>

    <div class="bg-white border border-[#E8E9EB] rounded-[48px] p-10 md:p-16 shadow-2xl shadow-indigo-50/20 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-[#6C5DD3]/5 rounded-full -mr-48 -mt-48 blur-3xl opacity-50"></div>
      
      <div class="relative z-10">
        <div class="prose prose-indigo prose-lg max-w-none prose-headings:font-extrabold prose-p:text-[#6C6D70] prose-p:leading-relaxed prose-strong:text-[#2D2E32] prose-ul:list-disc prose-li:text-[#6C6D70]">
          <%= @note.content %>
        </div>

        <div class="mt-16 pt-12 border-t border-[#E8E9EB]">
          <h3 class="text-[10px] font-black uppercase text-[#6C6D70] tracking-[0.2em] mb-4">Mastered Concepts</h3>
          <div class="flex flex-wrap gap-2">
            <% Array(@note.key_concepts).each do |concept| %>
              <span class="px-5 py-2.5 bg-gray-50 border border-[#E8E9EB] rounded-full text-xs font-bold text-[#2D2E32] hover:border-[#6C5DD3] hover:bg-[#6C5DD3]/5 transition-all cursor-default">
                <%= concept %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-20 text-center">
      <h2 class="text-2xl font-extrabold text-[#2D2E32] mb-4">Want to generate your own?</h2>
      <p class="text-[#6C6D70] font-medium mb-10">Transform any video or document into structured highlights in seconds.</p>
      <%= link_to "Join StudyWISE Today", root_path, class: "inline-flex items-center gap-3 px-10 py-5 bg-[#6C5DD3] text-white rounded-[24px] font-black text-sm tracking-tight hover:bg-[#5849C4] hover:-translate-y-1 transition-all shadow-2xl shadow-indigo-100" %>
    </div>
  </div>
</div>
