<% content_for :title, "Shared Note | StudyWISE" %>

<div class="min-h-screen py-16 sm:py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-center gap-2 mb-12 sm:mb-16">
      <div class="ds-logo-mark">Sw</div>
      <span class="text-lg font-semibold text-white tracking-tight">StudyWISE</span>
    </div>

    <header class="mb-12 sm:mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#1f2937] bg-[#111113] mb-6">
        <span class="w-1.5 h-1.5 bg-[#bef264] rounded-full"></span>
        <span class="text-[10px] font-semibold uppercase tracking-wider" style="color: #94a3b8;">Shared Study Insights</span>
      </div>
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4 sm:mb-6 leading-tight"><%= @note.title %></h1>
      <p class="font-medium text-sm sm:text-base leading-relaxed max-w-2xl mx-auto" style="color: #94a3b8;">Original Material: <span class="text-white underline decoration-[#1f2937] decoration-2 underline-offset-4"><%= @material.title %></span></p>

      <div class="flex items-center justify-center gap-4 sm:gap-6 mt-8 sm:mt-10">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 bg-[#111113] border border-[#1f2937] rounded-full flex items-center justify-center" style="color: #94a3b8;">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="text-[10px] font-semibold uppercase tracking-wider" style="color: #94a3b8;">StudyWISE AI</span>
        </div>
        <div class="w-1 h-1 bg-[#374151] rounded-full"></div>
        <time class="text-[10px] font-semibold uppercase tracking-wider" style="color: #94a3b8;"><%= @note.created_at.strftime("%B %d, %Y") %></time>
      </div>
    </header>

    <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-6 sm:p-10 md:p-16 shadow-lg relative overflow-hidden">
      <div class="relative z-10">
        <div class="prose prose-invert prose-sm sm:prose-base md:prose-lg max-w-none prose-headings:font-bold prose-p:text-[#94a3b8] prose-p:leading-relaxed prose-strong:text-white prose-ul:list-disc prose-li:text-[#94a3b8]">
          <%= @note.content %>
        </div>

        <div class="mt-12 sm:mt-16 pt-8 sm:pt-12 border-t border-[#1f2937]">
          <h3 class="text-[10px] font-semibold uppercase tracking-wider mb-4" style="color: #94a3b8;">Mastered Concepts</h3>
          <div class="flex flex-wrap gap-2">
            <% Array(@note.key_concepts).each do |concept| %>
              <span class="px-4 py-2 bg-[#111113] border border-[#1f2937] rounded-full text-[11px] font-semibold hover:border-[#bef264] hover:text-[#bef264] transition-all cursor-default" style="color: #94a3b8;">
                <%= concept %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 sm:mt-20 text-center">
      <h2 class="text-xl sm:text-2xl font-semibold text-white mb-4 sm:mb-6">Want to generate your own study insights?</h2>
      <%= link_to root_path, class: "inline-flex items-center gap-2 px-8 py-4 bg-[#bef264] text-black rounded-full font-semibold text-xs tracking-tight hover:bg-[#a3e635] transition-all shadow-[0_0_24px_rgba(190,242,100,0.3)]" do %>
        <span>Join StudyWISE Today</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
