<% content_for :title, "Overview | StudyWISE" %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-10">
  <div class="bg-[#09090b] border border-[#1f2937] p-4 sm:p-5 rounded-2xl shadow-lg">
    <div class="text-[11px] font-medium mb-2" style="color: #94a3b8;">AI pass rate</div>
    <div class="flex items-baseline gap-1">
      <div class="text-2xl font-semibold text-white"><%= @llm_success_rate %>%</div>
    </div>
  </div>
  <div class="bg-[#09090b] border border-[#1f2937] p-4 sm:p-5 rounded-2xl shadow-lg">
    <div class="text-[11px] font-medium mb-2" style="color: #94a3b8;">Materials</div>
    <div class="text-2xl font-semibold text-white"><%= @materials_count %></div>
  </div>
  <div class="bg-[#09090b] border border-[#1f2937] p-4 sm:p-5 rounded-2xl shadow-lg">
    <div class="text-[11px] font-medium mb-2" style="color: #94a3b8;">Notes created</div>
    <div class="text-2xl font-semibold text-white"><%= @notes_count %></div>
  </div>
  <div class="bg-[#09090b] border border-[#1f2937] p-4 sm:p-5 rounded-2xl shadow-lg">
    <div class="text-[11px] font-medium mb-2" style="color: #94a3b8;">AI prompts (24h)</div>
    <div class="text-2xl font-semibold text-white"><%= @llm_calls_count %></div>
  </div>
</div>

<div class="grid grid-cols-1 gap-6">
  <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-5 sm:p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-white">AI health</h2>
      <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium <%= @llm_health_label == 'Unstable' ? 'border-rose-500/30 bg-rose-500/10' : 'border-emerald-500/30 bg-emerald-500/10' %>" style="<%= @llm_health_label == 'Unstable' ? 'color: #fca5a5;' : 'color: #bbf7d0;' %>">
        <%= @llm_health_label %>
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Average latency</p>
        <p class="text-lg font-semibold text-white"><%= @llm_avg_latency %>ms</p>
      </div>
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">P95 latency</p>
        <p class="text-lg font-semibold text-white"><%= @llm_p95_latency %>ms</p>
      </div>
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Pass rate</p>
        <p class="text-lg font-semibold text-white"><%= @llm_success_rate %>%</p>
      </div>
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Failures (24h)</p>
        <p class="text-lg font-semibold <%= @llm_failure_count.positive? ? '' : 'text-[#bbf7d0]' %>" style="<%= @llm_failure_count.positive? ? 'color: #fca5a5;' : '' %>"><%= @llm_failure_count %> <span class="text-sm" style="color: #94a3b8;">(<%= @llm_failure_rate %>%)</span></p>
      </div>
    </div>

    <div class="mb-6 grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Traffic profile</p>
        <p class="text-sm" style="color: #e2e8f0;">
          Prompt chars: <span class="font-semibold text-white"><%= number_with_delimiter(@llm_prompt_chars) %></span>
          <span class="mx-1.5" style="color: #374151;">•</span>
          Response chars: <span class="font-semibold text-white"><%= number_with_delimiter(@llm_response_chars) %></span>
        </p>
      </div>
      <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
        <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Last failure</p>
        <% if @llm_last_failure.present? %>
          <p class="text-sm font-medium truncate" style="color: #fca5a5;"><%= @llm_last_failure.operation.to_s.titleize %> • <%= @llm_last_failure.created_at.strftime("%H:%M") %></p>
          <p class="text-[11px] mt-1 line-clamp-2" style="color: #94a3b8;"><%= @llm_last_failure.error_message.to_s.presence || "No error message captured." %></p>
        <% else %>
          <p class="text-sm font-medium" style="color: #bbf7d0;">No failed events in the last 24 hours.</p>
        <% end %>
      </div>
    </div>

    <h3 class="text-xs font-semibold uppercase tracking-[0.16em] mb-3" style="color: #94a3b8;">Operation health (24h)</h3>
    <% if @llm_operation_health.any? %>
      <div class="mb-6 overflow-hidden rounded-xl border border-[#1f2937]">
        <div class="grid grid-cols-4 bg-[#111113] px-3 py-2 text-[10px] font-semibold uppercase tracking-wider" style="color: #94a3b8;">
          <p>Operation</p>
          <p class="text-center">Calls</p>
          <p class="text-center">Success</p>
          <p class="text-right">Avg latency</p>
        </div>
        <% @llm_operation_health.each do |row| %>
          <div class="grid grid-cols-4 border-t border-[#1f2937] px-3 py-2.5 text-xs">
            <p class="font-semibold text-white"><%= row[:operation].to_s.titleize %></p>
            <p class="text-center" style="color: #e2e8f0;"><%= row[:total] %></p>
            <p class="text-center font-semibold <%= row[:success_rate] >= 95 ? 'text-[#bbf7d0]' : (row[:success_rate] >= 85 ? 'text-amber-500' : 'text-[#fca5a5]') %>"><%= row[:success_rate] %>%</p>
            <p class="text-right" style="color: #e2e8f0;"><%= row[:avg_latency] %>ms</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="mb-6 rounded-xl border border-dashed border-[#1f2937] bg-[#111113] p-4 text-xs" style="color: #94a3b8;">
        No operation-level data in the last 24 hours.
      </div>
    <% end %>

    <h3 class="text-xs font-semibold uppercase tracking-[0.16em] mb-3" style="color: #94a3b8;">Recent events</h3>
    <% if @llm_events.any? %>
      <div class="space-y-2 max-h-72 overflow-y-auto pr-1 custom-scrollbar">
        <% @llm_events.each do |event| %>
          <div class="flex items-center justify-between rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-2.5">
            <div>
              <p class="text-xs font-semibold text-white mb-0.5"><%= event.operation.titleize %></p>
              <p class="text-[11px]" style="color: #94a3b8;"><%= event.model %> • <%= event.created_at.strftime("%H:%M") %></p>
            </div>
            <div class="flex items-center gap-2">
              <% if policy(event).show? %>
                <%= link_to "Details", admin_llm_event_path(event), class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] bg-[#09090b] px-2 py-1 text-[10px] font-semibold hover:border-[#bef264] hover:text-[#bef264] transition-colors" %>
              <% end %>
              <span class="h-2 w-2 rounded-full <%= event.success ? 'bg-[#bef264]' : 'bg-rose-500' %>"></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-10 flex flex-col items-center justify-center border border-dashed border-[#1f2937] rounded-xl text-center bg-[#111113]">
        <p class="text-sm" style="color: #94a3b8;">No AI events recorded yet. Start a study chat or generate notes to see activity here.</p>
      </div>
    <% end %>
  </div>
</div>
