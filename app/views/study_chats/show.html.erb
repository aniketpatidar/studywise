<div class="h-[calc(100vh-12rem)] lg:h-[calc(100vh-8rem)] max-w-5xl mx-auto flex flex-col bg-white border border-[#E8E9EB] sm:rounded-[40px] shadow-sm overflow-hidden mb-4">
  <!-- Chat Header -->
  <div class="flex items-center justify-between px-6 sm:px-10 py-4 sm:py-6 border-b border-[#E8E9EB] bg-gray-50/50">
    <div class="flex items-center gap-3 sm:gap-4 overflow-hidden">
      <div class="w-8 h-8 sm:w-10 sm:h-10 bg-[#6C5DD3] rounded-xl sm:rounded-2xl flex items-center justify-center text-white text-base sm:text-lg flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="min-w-0">
        <h1 class="text-base sm:text-xl font-extrabold text-[#2D2E32] truncate">Study Assistant</h1>
        <p class="text-[9px] sm:text-[10px] font-bold text-[#6C6D70] uppercase tracking-widest flex items-center gap-2 truncate">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full flex-shrink-0"></span>
          <span class="truncate"><%= @material.title %></span>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= link_to material_path(@material), class: "p-2 sm:p-2.5 border border-[#E8E9EB] rounded-lg sm:rounded-xl text-[#6C6D70] hover:bg-white hover:text-[#2D2E32] transition-all shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18 18.246 18.477 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="flex-grow overflow-y-auto px-6 sm:px-10 py-6 sm:py-10 space-y-6 sm:space-y-8 scroll-smooth custom-scrollbar" id="chat-bubbles">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-[90%] sm:max-w-[80%] flex items-start gap-3 sm:gap-4 <%= message.role == 'user' ? 'flex-row-reverse' : '' %>">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-xs sm:text-sm <%= message.role == 'user' ? 'bg-[#6C5DD3] text-white' : 'bg-white border border-[#E8E9EB]' %>">
              <% if message.role == 'user' %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              <% end %>
            </div>
            <div class="<%= message.role == 'user' ? 'bg-[#6C5DD3] text-white rounded-t-[20px] rounded-bl-[20px] sm:rounded-t-[24px] sm:rounded-bl-[24px]' : 'bg-gray-100/80 text-[#2D2E32] rounded-t-[20px] rounded-br-[20px] sm:rounded-t-[24px] sm:rounded-br-[24px]' %> px-4 sm:px-6 py-3 sm:py-4 shadow-sm">
              <div class="prose prose-sm <%= message.role == 'user' ? 'prose-invert' : '' %> max-w-none text-xs sm:text-sm font-medium leading-relaxed">
                <%= message.content %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="h-full flex flex-col items-center justify-center text-center max-w-md mx-auto px-4">
        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-[#6C5DD3]/10 text-[#6C5DD3] flex items-center justify-center rounded-[24px] sm:rounded-[32px] mb-6 sm:mb-8 animate-bounce transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#2D2E32] mb-3">How can I help you study?</h2>
        <p class="text-[#6C6D70] mb-8 sm:mb-10 leading-relaxed font-medium text-sm sm:text-base text-balance">I've analyzed your material. You can ask for a summary, practice questions, or deep explanations.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
          <%= link_to generate_quiz_material_path(@material), data: { turbo_method: :post }, class: "p-4 bg-white border border-[#E8E9EB] rounded-2xl sm:rounded-3xl hover:border-[#6C5DD3] hover:bg-[#6C5DD3]/5 transition-all text-left group" do %>
            <div class="w-8 h-8 bg-indigo-50 text-[#6C5DD3] rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a2 2 0 00-1.96 1.414l-.727 2.903a2 2 0 01-3.664 0l-.727-2.903a2 2 0 00-1.96-1.414l-2.387.477a2 2 0 00-1.022.547l2.146 2.146a2 2 0 01.586 1.414V21" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 7h15M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" />
              </svg>
            </div>
            <h3 class="font-bold text-[#2D2E32] group-hover:text-[#6C5DD3] text-xs sm:text-sm">Create Quiz</h3>
            <p class="text-[10px] text-[#6C6D70] mt-1 pr-2">Test your knowledge with AI questions.</p>
          <% end %>
          
          <%= link_to material_notes_path(@material), class: "p-4 bg-white border border-[#E8E9EB] rounded-2xl sm:rounded-3xl hover:border-[#6C5DD3] hover:bg-[#6C5DD3]/5 transition-all text-left group" do %>
            <div class="w-8 h-8 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-[#2D2E32] group-hover:text-[#6C5DD3] text-xs sm:text-sm">Review Notes</h3>
            <p class="text-[10px] text-[#6C6D70] mt-1 pr-2">See your study points and summaries.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Input Area -->
  <div class="px-6 sm:px-10 py-6 sm:py-8 border-t border-[#E8E9EB] bg-gray-50/50">
    <%= form_with url: study_chat_material_path(@material), method: :post, class: "relative group" do |f| %>
      <%= f.text_area :message, 
          placeholder: "Type your question here...", 
          required: true, 
          rows: 1,
          class: "w-full pl-5 pr-14 sm:pl-6 sm:pr-16 py-3 sm:py-4 bg-white border border-[#E8E9EB] rounded-xl sm:rounded-2xl text-xs sm:text-sm font-medium focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 placeholder:text-[#B1B5C3] transition-all resize-none shadow-sm group-focus-within:shadow-md" 
      %>
      <button type="submit" class="absolute right-2 sm:right-3 bottom-2 sm:bottom-2.5 w-10 h-10 sm:w-11 sm:h-11 bg-[#6C5DD3] text-white rounded-lg sm:rounded-xl hover:bg-[#5849C4] transition-all flex items-center justify-center shadow-lg shadow-indigo-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chatLog = document.getElementById('chat-bubbles');
    if (chatLog) {
      chatLog.scrollTop = chatLog.scrollHeight;
    }
    
    const textarea = document.querySelector('textarea');
    if (textarea) {
      textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
        if (chatLog) chatLog.scrollTop = chatLog.scrollHeight;
      });
    }
  })();
</script>
