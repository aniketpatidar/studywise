<div class="max-w-5xl mx-auto flex flex-col bg-[#09090b] border border-[#1f2937] sm:rounded-3xl shadow-lg overflow-visible mb-4 lg:h-[calc(100dvh-8rem)] lg:overflow-hidden">
  <div class="px-6 sm:px-8 py-5 border-b border-[#1f2937] bg-[#111113]">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-medium tracking-wider uppercase" style="color: #94a3b8;">Study Chat</p>
        <h1 class="text-lg sm:text-xl font-semibold text-white leading-snug truncate">Interactive notes for "<%= @material.title %>"</h1>
      </div>
      <div class="hidden sm:flex items-center gap-2 flex-shrink-0">
        <%= link_to material_path(@material), class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] bg-[#09090b] px-3 py-1.5 text-[11px] font-semibold hover:border-[#bef264] hover:text-[#bef264] shadow-sm transition" do %>
          Source
        <% end %>
      </div>
    </div>

    <div class="mt-5 rounded-2xl bg-[#111113] border border-[#1f2937] p-4">
      <div class="flex flex-col gap-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-3 min-w-0">
            <% source_type = @material.source_type.to_s.downcase %>
            <div class="h-8 w-8 rounded-full bg-[#09090b] border border-[#1f2937] flex items-center justify-center text-[10px] font-bold flex-shrink-0 overflow-hidden leading-none uppercase" style="color: #e2e8f0;">
              <%= source_type == "youtube" ? "YT" : source_type.first(2) %>
            </div>
            <div class="min-w-0">
              <p class="text-[10px] font-medium uppercase tracking-wider mb-0.5" style="color: #94a3b8;">Current source</p>
              <p class="text-xs font-semibold text-white truncate">
                <%= @material.title %>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= link_to material_notes_path(@material), class: "inline-flex items-center justify-center rounded-full bg-[#bef264] px-4 py-1.5 text-[11px] font-semibold text-black hover:bg-[#a3e635] transition shadow-[0_0_24px_rgba(190,242,100,0.3)]" do %>
              View Notes
            <% end %>
            <%= link_to generate_quiz_material_path(@material), data: { turbo_method: :post }, class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] bg-[#09090b] px-4 py-1.5 text-[11px] font-semibold hover:border-[#bef264] hover:text-[#bef264] transition" do %>
              Generate Quiz
            <% end %>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:justify-between">
          <div class="inline-flex items-center gap-2">
            <span class="text-[10px] font-semibold uppercase tracking-wider" style="color: #94a3b8;">Memory</span>
            <%= form_with url: study_chat_material_path(@material), method: :post, class: "inline-flex items-center gap-1.5 flex-wrap" do |f| %>
              <%= f.hidden_field :message, value: "" %>
              <% @memory_mode_options.each do |option| %>
                <% label, value = option.is_a?(Array) ? option : [option, option] %>
                <button
                  type="submit"
                  name="memory_mode"
                  value="<%= value %>"
                  <%= "disabled" unless @chat_enabled %>
                  class="rounded-full border px-3 py-1 text-[11px] font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed <%= @memory_mode.to_s == value.to_s ? 'border-[#bef264] bg-[#bef264] text-black' : 'border-[#1f2937] bg-[#09090b] hover:border-[#bef264] hover:text-[#bef264]' %>" style="<%= @memory_mode.to_s != value.to_s ? 'color: #94a3b8;' : '' %>">
                  <%= label %>
                </button>
              <% end %>
            <% end %>
          </div>
          <div class="flex items-center gap-2">
            <%= button_to "Reset Chat", study_chat_material_path(@material), method: :delete, class: "inline-flex items-center justify-center rounded-full border border-rose-500/30 bg-[#09090b] px-3 py-1.5 text-[11px] font-semibold hover:bg-rose-500/10 transition", style: "color: #fca5a5;" %>
          </div>
        </div>
        <% unless @chat_enabled %>
          <p class="text-[11px] font-medium" style="color: #fcd34d;">Study chat is locked until extraction completes. Generate a note first.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="min-h-0 flex-grow px-6 sm:px-8 py-6 space-y-5 scroll-smooth custom-scrollbar lg:overflow-y-auto" id="chat-bubbles">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-[90%] sm:max-w-[80%] flex items-start gap-3 <%= message.role == 'user' ? 'flex-row-reverse' : '' %>">
            <div class="w-7 h-7 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-[10px] font-semibold <%= message.role == 'user' ? 'bg-[#bef264] text-black' : 'bg-[#111113] border border-[#1f2937]' %>" style="<%= message.role != 'user' ? 'color: #94a3b8;' : '' %>">
              <% if message.role == 'user' %>
                <%= current_user.name.first.upcase %>
              <% else %>
                AI
              <% end %>
            </div>
            <div class="<%= message.role == 'user' ? 'bg-[#bef264] text-black rounded-2xl rounded-tr-none' : 'bg-[#111113] rounded-2xl rounded-tl-none border border-[#1f2937]' %> px-4 py-3 shadow-sm">
              <% body, citations = message.content.to_s.split("\n\nCitations:\n", 2) %>
              <div class="prose prose-sm <%= message.role == 'user' ? 'prose-invert' : '' %> max-w-none text-xs sm:text-sm font-medium leading-relaxed">
                <%= simple_format(body) %>
              </div>
              <% if message.role == "assistant" && citations.present? %>
                <details class="mt-2 rounded-xl border border-[#1f2937] bg-[#09090b] px-3 py-2 text-[11px]">
                  <summary class="cursor-pointer font-semibold" style="color: #e2e8f0;">Sources</summary>
                  <div class="mt-2 space-y-1" style="color: #94a3b8;">
                    <% citations.split("\n").reject(&:blank?).each do |line| %>
                      <p><%= line.delete_prefix("- ").strip %></p>
                    <% end %>
                  </div>
                </details>
              <% end %>
              <% if message.role == "assistant" %>
                <div class="mt-2 flex justify-end">
                  <%= button_to "Retry", regenerate_study_chat_material_path(@material), method: :post, params: { assistant_message_id: message.id, memory_mode: @memory_mode }, class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] bg-[#09090b] px-2.5 py-1 text-[10px] font-semibold hover:border-[#bef264] hover:text-[#bef264] transition" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div id="chat-empty-state" class="h-full flex flex-col items-center justify-center text-center max-w-md mx-auto px-4">
        <div class="w-12 h-12 bg-[#111113] border border-[#1f2937] flex items-center justify-center rounded-xl mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #94a3b8;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
        </div>
        <% if @chat_enabled %>
          <h2 class="text-lg font-semibold text-white mb-2">Ask anything about your material</h2>
          <p class="mb-8 leading-relaxed text-xs" style="color: #94a3b8;">
            Start with a question or use the shortcuts above to generate smart notes and quick quizzes.
          </p>
        <% else %>
          <h2 class="text-lg font-semibold text-white mb-2">Chat unlocks after extraction</h2>
          <p class="mb-8 leading-relaxed text-xs" style="color: #94a3b8;">
            Generate notes after extraction succeeds, then return here to start asking questions.
          </p>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="relative z-10 px-6 sm:px-8 py-5 border-t border-[#1f2937] bg-[#111113]">
    <p id="chat-pending-state" class="hidden mb-2 text-[11px] font-medium" style="color: #94a3b8;">Generating response...</p>
    <% if @chat_enabled %>
      <%= form_with url: study_chat_material_path(@material), method: :post, id: "chat-compose-form", data: { stream_url: stream_study_chat_material_path(@material) }, class: "flex items-center gap-2" do |f| %>
        <%= f.hidden_field :memory_mode, value: @memory_mode %>
        <%= f.text_field :message,
            placeholder: "Ask something about this material...",
            required: true,
            id: "chat-input",
            class: "w-full px-4 py-3 bg-[#09090b] border border-[#374151] rounded-2xl text-sm font-medium placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-4 focus:ring-[#bef264]/20 transition-all shadow-sm",
            style: "color: #ffffff;"
        %>
        <button id="chat-send-button" type="submit" class="rounded-xl bg-[#bef264] text-black hover:bg-[#a3e635] transition-all flex items-center justify-center shadow-md shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" style="width: 2.5rem; height: 2.2rem;">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 11.5l14-6.5-6.5 14-1.5-5-5-1.5z" />
          </svg>
        </button>
      <% end %>
    <% else %>
      <div class="flex items-center gap-2">
        <input
          type="text"
          id="chat-input"
          disabled
          placeholder="Chat unlocks after extraction is complete..."
          class="w-full px-4 py-3 bg-[#111113] border border-[#1f2937] rounded-2xl text-sm font-medium cursor-not-allowed shadow-sm"
          style="color: #94a3b8;"
        >
        <button type="button" disabled class="rounded-xl bg-[#374151] flex items-center justify-center shadow-md shrink-0 cursor-not-allowed" style="width: 2.5rem; height: 2.2rem;">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #64748b;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 11.5l14-6.5-6.5 14-1.5-5-5-1.5z" />
          </svg>
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chatLog = document.getElementById('chat-bubbles');
    if (chatLog) {
      chatLog.scrollTop = chatLog.scrollHeight;
    }

    const composeForm = document.getElementById('chat-compose-form');
    const pendingState = document.getElementById('chat-pending-state');
    const input = document.getElementById('chat-input');
    const sendButton = document.getElementById('chat-send-button');
    const emptyState = document.getElementById('chat-empty-state');

    if (composeForm && pendingState && input && sendButton) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

      const appendBubble = (role, content) => {
        const wrapper = document.createElement('div');
        wrapper.className = "flex " + (role === "user" ? "justify-end" : "justify-start");

        const row = document.createElement('div');
        row.className = "max-w-[90%] sm:max-w-[80%] flex items-start gap-3 " + (role === "user" ? "flex-row-reverse" : "");

        const avatar = document.createElement('div');
        avatar.className = "w-7 h-7 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-[10px] font-semibold " +
          (role === "user" ? "bg-[#bef264] text-black" : "bg-[#111113] border border-[#1f2937]");
        avatar.style.color = role === "user" ? "#000" : "#94a3b8";
        avatar.textContent = role === "user" ? "You" : "AI";

        const bubble = document.createElement('div');
        bubble.className = (role === "user"
          ? "bg-[#bef264] text-black rounded-2xl rounded-tr-none"
          : "bg-[#111113] rounded-2xl rounded-tl-none border border-[#1f2937]") + " px-4 py-3 shadow-sm";

        const text = document.createElement('div');
        text.className = "whitespace-pre-wrap text-xs sm:text-sm font-medium leading-relaxed";
        text.style.color = role === "user" ? "#000" : "#e2e8f0";
        text.textContent = content || "";

        bubble.appendChild(text);
        row.appendChild(avatar);
        row.appendChild(bubble);
        wrapper.appendChild(row);
        chatLog.appendChild(wrapper);
        chatLog.scrollTop = chatLog.scrollHeight;
        return text;
      };

      const parseSseBlocks = (buffer, onEvent) => {
        let remaining = buffer;
        while (true) {
          const splitAt = remaining.indexOf("\n\n");
          if (splitAt === -1) break;
          const block = remaining.slice(0, splitAt);
          remaining = remaining.slice(splitAt + 2);
          const data = block
            .split("\n")
            .filter((line) => line.startsWith("data:"))
            .map((line) => line.replace(/^data:\s?/, ""))
            .join("\n");
          if (!data) continue;
          try {
            onEvent(JSON.parse(data));
          } catch (_e) {
          }
        }
        return remaining;
      };

      composeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const streamUrl = composeForm.dataset.streamUrl;
        const message = input.value.trim();
        if (!message || !streamUrl) return;

        pendingState.classList.remove('hidden');
        input.setAttribute('readonly', 'readonly');
        sendButton.disabled = true;
        if (emptyState) emptyState.classList.add("hidden");

        appendBubble("user", message);
        const assistantTextNode = appendBubble("assistant", "");
        let assistantContent = "";

        try {
          const formData = new FormData(composeForm);
          formData.set("message", message);

          const response = await fetch(streamUrl, {
            method: "POST",
            headers: {
              "Accept": "text/event-stream",
              "X-CSRF-Token": csrfToken || ""
            },
            body: formData
          });

          if (!response.ok || !response.body) {
            throw new Error("Streaming request failed.");
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = "";

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            buffer = parseSseBlocks(buffer, (payload) => {
              if (payload.type === "chunk" && payload.content) {
                assistantContent += payload.content;
                assistantTextNode.textContent = assistantContent;
                chatLog.scrollTop = chatLog.scrollHeight;
              }
            });
          }

          input.value = "";
        } catch (_error) {
          assistantTextNode.textContent = "Response failed while streaming. Please retry.";
        } finally {
          pendingState.classList.add('hidden');
          input.removeAttribute('readonly');
          sendButton.disabled = false;
          input.focus();
        }
      });
    }
  })();
</script>
