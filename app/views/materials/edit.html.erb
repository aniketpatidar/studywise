<% content_for :title, "Edit Material | StudyWISE" %>

<div class="max-w-4xl mx-auto pb-20">
  <header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">Edit study material</h1>
    </div>
    <div class="flex-shrink-0">
      <%= link_to material_path(@material), class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] px-3.5 py-1.5 text-xs font-semibold hover:border-[#bef264] hover:text-[#bef264] bg-[#09090b] transition-colors" do %>
        Back
      <% end %>
    </div>
  </header>

  <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-5 sm:p-6 shadow-lg">
    <%= render "form", material: @material %>
  </div>
</div>
