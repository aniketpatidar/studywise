<% content_for :title, "Edit Material | StudyWISE" %>

<div class="max-w-4xl mx-auto pb-20">
  <header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">Edit material</h1>
      <p class="mt-1 text-sm text-slate-600">
        Adjust the title or source so your Study Chat stays aligned with the right context.
      </p>
    </div>
    <div class="flex-shrink-0">
      <%= link_to material_path(@material), class: "inline-flex items-center justify-center rounded-full border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900" do %>
        Back to details
      <% end %>
    </div>
  </header>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm">
    <%= render "form", material: @material %>
  </div>
</div>
