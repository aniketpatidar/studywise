<%= form_with model: material, class: "space-y-6" do |f| %>
  <% if material.errors.any? %>
    <div class="p-4 bg-rose-500/10 border border-rose-500/30 rounded-xl mb-4">
      <div class="flex items-center gap-3 font-semibold mb-2 text-sm" style="color: #fca5a5;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>There were some issues:</span>
      </div>
      <ul class="space-y-1 ml-5 text-[11px] list-disc" style="color: #fca5a5;">
        <% material.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div class="space-y-2.5">
      <%= f.label :title, class: "block text-[11px] font-medium pl-1", style: "color: #94a3b8;" %>
      <%= f.text_field :title, required: true,
          placeholder: "e.g. Introduction to Quantum Physics",
          class: "w-full px-3.5 py-2.5 bg-[#111113] border border-[#374151] rounded-lg text-sm placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-2 focus:ring-[#bef264]/20 transition",
          style: "color: #ffffff;"
      %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2.5">
        <%= f.label :source_type, class: "block text-[11px] font-medium pl-1", style: "color: #94a3b8;" %>
        <%= f.select :source_type, Material::SOURCE_TYPES.map { |s| [s.titleize, s] }, {},
            class: "w-full px-3.5 py-2.5 bg-[#111113] border border-[#374151] rounded-lg text-sm placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-2 focus:ring-[#bef264]/20 transition appearance-none cursor-pointer",
            style: "color: #ffffff;"
        %>
      </div>

      <div class="space-y-2.5">
        <%= f.label :source_url, "YouTube URL (optional)", class: "block text-[11px] font-medium pl-1", style: "color: #94a3b8;" %>
        <%= f.url_field :source_url,
            placeholder: "https://www.youtube.com/watch?v=...",
            class: "w-full px-3.5 py-2.5 bg-[#111113] border border-[#374151] rounded-lg text-sm placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-2 focus:ring-[#bef264]/20 transition",
            style: "color: #ffffff;"
        %>
      </div>
    </div>

    <div class="p-5 border border-dashed border-[#374151] rounded-xl bg-[#111113] hover:border-[#bef264]/40 transition">
      <%= f.label :source_file, class: "block cursor-pointer" do %>
        <div class="flex flex-col items-center text-center">
          <div class="w-10 h-10 bg-[#09090b] border border-[#1f2937] rounded-lg flex items-center justify-center text-[#94a3b8] mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
          </div>
          <span class="text-sm font-medium mb-0.5" style="color: #e2e8f0;">Click to upload document</span>
          <span class="text-[11px]" style="color: #94a3b8;">PDF, TXT, MD, DOCX, PPTX</span>
        </div>
        <%= f.file_field :source_file, accept: ".pdf,.txt,.md,.docx,.pptx", class: "hidden", id: "material_source_file_input" %>
      <% end %>
      <p id="material_source_file_name" class="mt-3 text-center text-[11px] font-medium" style="color: #94a3b8;">
        No file selected
      </p>
    </div>

    <div class="space-y-2.5">
      <%= f.label :raw_text, "Or paste content here", class: "block text-[11px] font-medium pl-1", style: "color: #94a3b8;" %>
      <%= f.text_area :raw_text, rows: 6,
          placeholder: "Paste your study notes, textbook excerpts, or lecture transcripts here...",
          class: "w-full px-3.5 py-2.5 bg-[#111113] border border-[#374151] rounded-lg text-sm placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-2 focus:ring-[#bef264]/20 transition resize-none h-40",
          style: "color: #ffffff;"
      %>
    </div>
  </div>

  <div class="pt-5 border-t border-[#1f2937] flex flex-col sm:flex-row items-center justify-end gap-4">
    <%= link_to "Cancel", materials_path, class: "order-2 sm:order-1 text-xs font-semibold hover:text-[#bef264] transition-colors", style: "color: #94a3b8;" %>
    <%= f.submit "Save material", class: "order-1 sm:order-2 w-full sm:w-auto px-4 py-2 bg-[#bef264] text-black rounded-full font-semibold text-xs tracking-tight hover:bg-[#a3e635] cursor-pointer shadow-[0_0_24px_rgba(190,242,100,0.3)] transition-colors"
    %>
  </div>
<% end %>

<script>
  (function() {
    const bindFileNamePreview = () => {
      const input = document.getElementById("material_source_file_input");
      const nameNode = document.getElementById("material_source_file_name");
      if (!input || !nameNode || input.dataset.boundFileNamePreview === "1") return;

      const render = () => {
        const file = input.files && input.files[0];
        nameNode.textContent = file ? `Selected: ${file.name}` : "No file selected";
      };

      input.addEventListener("change", render);
      input.dataset.boundFileNamePreview = "1";
      render();
    };

    document.addEventListener("turbo:load", bindFileNamePreview, { once: true });
    bindFileNamePreview();
  })();
</script>
