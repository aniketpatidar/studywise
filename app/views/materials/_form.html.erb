<%= form_with model: material, class: "space-y-6" do |f| %>
  <% if material.errors.any? %>
    <div class="p-4 bg-rose-50 border border-rose-100 rounded-xl mb-4">
      <div class="flex items-center gap-3 text-rose-700 font-semibold mb-2 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>There were some issues:</span>
      </div>
      <ul class="space-y-1 ml-5 text-[11px] text-rose-700 list-disc">
        <% material.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div class="space-y-2.5">
      <%= f.label :title, class: "block text-[11px] font-medium text-slate-700 pl-1" %>
      <%= f.text_field :title, required: true, 
          placeholder: "e.g. Introduction to Quantum Physics", 
          class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-2 focus:ring-slate-900/10 transition" 
      %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2.5">
        <%= f.label :source_type, class: "block text-[11px] font-medium text-slate-700 pl-1" %>
        <%= f.select :source_type, Material::SOURCE_TYPES.map { |s| [s.titleize, s] }, {}, 
            class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-2 focus:ring-slate-900/10 transition appearance-none cursor-pointer" 
        %>
      </div>

      <div class="space-y-2.5">
        <%= f.label :source_url, "YouTube URL (optional)", class: "block text-[11px] font-medium text-slate-700 pl-1" %>
        <%= f.url_field :source_url, 
            placeholder: "https://www.youtube.com/watch?v=...", 
            class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-2 focus:ring-slate-900/10 transition" 
        %>
      </div>
    </div>

    <div class="p-5 border border-dashed border-slate-200 rounded-xl bg-slate-50/60 hover:bg-white transition">
      <%= f.label :source_file, class: "block cursor-pointer" do %>
        <div class="flex flex-col items-center text-center">
          <div class="w-10 h-10 bg-white border border-slate-200 rounded-lg flex items-center justify-center text-slate-600 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
          </div>
          <span class="text-sm font-medium text-slate-900 mb-0.5">Click to upload document</span>
          <span class="text-[11px] text-slate-500">PDF, TXT, MD, DOCX, PPTX</span>
        </div>
        <%= f.file_field :source_file, accept: ".pdf,.txt,.md,.docx,.pptx", class: "hidden", id: "material_source_file_input" %>
      <% end %>
      <p id="material_source_file_name" class="mt-3 text-center text-[11px] font-medium text-slate-600">
        No file selected
      </p>
    </div>

    <div class="space-y-2.5">
      <%= f.label :raw_text, "Or paste content here", class: "block text-[11px] font-medium text-slate-700 pl-1" %>
      <%= f.text_area :raw_text, rows: 6, 
          placeholder: "Paste your study notes, textbook excerpts, or lecture transcripts here...", 
          class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-2 focus:ring-slate-900/10 transition resize-none h-40" 
      %>
    </div>
  </div>

  <div class="pt-5 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-end gap-4">
    <%= link_to "Cancel", materials_path, class: "order-2 sm:order-1 text-xs font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit "Save material", class: "order-1 sm:order-2 w-full sm:w-auto px-4 py-2 bg-slate-900 text-white rounded-full font-semibold text-xs tracking-tight hover:bg-black cursor-pointer" 
    %>
  </div>
<% end %>

<script>
  (function() {
    const bindFileNamePreview = () => {
      const input = document.getElementById("material_source_file_input");
      const nameNode = document.getElementById("material_source_file_name");
      if (!input || !nameNode || input.dataset.boundFileNamePreview === "1") return;

      const render = () => {
        const file = input.files && input.files[0];
        nameNode.textContent = file ? `Selected: ${file.name}` : "No file selected";
      };

      input.addEventListener("change", render);
      input.dataset.boundFileNamePreview = "1";
      render();
    };

    document.addEventListener("turbo:load", bindFileNamePreview, { once: true });
    bindFileNamePreview();
  })();
</script>
