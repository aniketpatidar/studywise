<%= form_with model: material, class: "space-y-8" do |f| %>
  <% if material.errors.any? %>
    <div class="p-6 bg-rose-50 border border-rose-100 rounded-[24px] mb-8">
      <div class="flex items-center gap-3 text-rose-700 font-bold mb-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Please correct the following:</span>
      </div>
      <ul class="space-y-1 ml-7 text-[10px] text-rose-600 font-bold uppercase tracking-wider list-disc">
        <% material.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="space-y-2.5">
      <%= f.label :title, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
      <%= f.text_field :title, required: true, 
          placeholder: "e.g. Introduction to Quantum Physics", 
          class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
      %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2.5">
        <%= f.label :source_type, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
        <%= f.select :source_type, Material::SOURCE_TYPES.map { |s| [s.titleize, s] }, {}, 
            class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all appearance-none cursor-pointer shadow-sm" 
        %>
      </div>

      <div class="space-y-2.5">
        <%= f.label :source_url, "YouTube URL (Optional)", class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
        <%= f.url_field :source_url, 
            placeholder: "https://www.youtube.com/watch?v=...", 
            class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-medium text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
        %>
      </div>
    </div>

    <div class="p-8 border-2 border-dashed border-[#E8E9EB] rounded-[32px] bg-gray-50/50 hover:bg-white hover:border-[#6C5DD3]/30 transition-all group">
      <%= f.label :source_file, class: "block cursor-pointer" do %>
        <div class="flex flex-col items-center text-center">
          <div class="w-14 h-14 bg-white border border-[#E8E9EB] rounded-[20px] flex items-center justify-center text-2xl shadow-sm mb-4 group-hover:scale-110 transition-transform text-[#6C5DD3]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
          </div>
          <span class="text-sm font-black text-[#2D2E32] mb-1">Click to upload document</span>
          <span class="text-[9px] font-black text-[#6C6D70] uppercase tracking-widest">PDF, TXT, MD, DOCX, PPTX</span>
        </div>
        <%= f.file_field :source_file, accept: ".pdf,.txt,.md,.docx,.pptx", class: "hidden" %>
      <% end %>
    </div>

    <div class="space-y-2.5">
      <%= f.label :raw_text, "Or paste content here", class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
      <%= f.text_area :raw_text, rows: 6, 
          placeholder: "Paste your study notes, textbook excerpts, or lecture transcripts here...", 
          class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-medium text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all resize-none shadow-sm h-40" 
      %>
    </div>
  </div>

  <div class="pt-8 border-t border-[#E8E9EB] flex flex-col sm:flex-row items-center justify-end gap-6">
    <%= link_to "Cancel", materials_path, class: "order-2 sm:order-1 text-sm font-black text-[#6C6D70] hover:text-[#2D2E32] transition-colors uppercase tracking-widest" %>
    <%= f.submit class: "order-1 sm:order-2 w-full sm:w-auto px-10 py-5 bg-[#6C5DD3] text-white rounded-[20px] font-black text-sm tracking-tight hover:bg-[#5849C4] hover:-translate-y-1 transition-all shadow-2xl shadow-indigo-100 cursor-pointer" 
    %>
  </div>
<% end %>
