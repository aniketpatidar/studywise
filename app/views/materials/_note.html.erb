<div id="<%= dom_id(note) %>" class="group p-4 bg-[#09090b] border border-[#1f2937] rounded-xl transition-all hover:border-[#bef264]/40 hover:bg-[#111113] shadow-lg">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div>
      <h3 class="font-semibold text-white group-hover:text-white transition-colors mb-1 text-sm"><%= note.title %></h3>
      <span class="text-[10px] font-medium uppercase tracking-wide" style="color: #94a3b8;"><%= note.created_at.strftime("%b %d, %Y") %></span>
    </div>
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= button_to share_material_note_path(note.material, note), method: :post, class: "p-1.5 bg-[#09090b] border border-[#1f2937] rounded-lg text-[#94a3b8] hover:text-[#bef264] hover:border-[#bef264] transition-colors", title: note.shared_public? ? "Disable Share" : "Share Note" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      <% end %>
      <% if note.shared_public? %>
        <%= link_to shared_note_path(note.share_token), target: "_blank", rel: "noopener", class: "p-1.5 bg-[#111113] border border-[#1f2937] rounded-lg text-[#94a3b8] hover:text-[#bef264] hover:border-[#bef264] transition-colors", title: "View Public Link" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="prose prose-sm max-w-none mb-3 line-clamp-2 text-xs" style="color: #94a3b8;">
    <%= note.content %>
  </div>

  <% if note.key_concepts.any? %>
    <div class="flex flex-wrap gap-1.5">
      <% note.key_concepts.each do |concept| %>
        <span class="px-2 py-0.5 bg-[#111113] border border-[#1f2937] rounded-md text-[9px] font-medium tracking-tight" style="color: #94a3b8;"><%= concept %></span>
      <% end %>
    </div>
  <% end %>
</div>
