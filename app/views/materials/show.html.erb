<header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-medium text-slate-600 tracking-wider uppercase">
        <span class="w-1.5 h-1.5 rounded-full <%= @material.status == 'completed' ? 'bg-emerald-500' : (@material.status == 'processing' ? 'bg-amber-500 animate-pulse' : 'bg-rose-500') %>"></span>
        <%= @material.status.to_s.humanize %>
      </span>
      <span class="text-[10px] font-medium uppercase text-slate-500 tracking-wider">
        Original source
      </span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">
      <%= @material.title %>
    </h1>
    <div class="flex flex-wrap items-center gap-3 mt-2 text-[11px] text-slate-600">
      <div class="inline-flex items-center gap-1.5">
        <span class="tracking-wider uppercase font-medium"><%= @material.source_type.to_s.titleize %> upload</span>
      </div>
      <span class="text-slate-300">•</span>
      <span class="uppercase tracking-wider font-medium"> Added <%= @material.created_at.strftime("%B %d, %Y") %></span>
    </div>
  </div>
  
  <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto mt-4 sm:mt-0">
    <%= link_to study_chat_material_path(@material), class: "inline-flex items-center justify-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-slate-50 hover:bg-black w-full sm:w-auto" do %>
      Study Chat
    <% end %>
    <%= link_to edit_material_path(@material), class: "inline-flex items-center justify-center rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 w-full sm:w-auto" do %>
      Edit
    <% end %>
  </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%= render "status_panel", material: @material %>
  <%= render "notes_panel", material: @material, notes: @notes %>
</div>

<div class="mt-8 bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm relative overflow-hidden">
  <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="text-sm font-semibold text-slate-900">Knowledge Checks</h2>
      <p class="text-[11px] text-slate-500 mt-1">Master this material through structured practice sessions.</p>
    </div>
    <span class="inline-flex items-center rounded-full bg-slate-50 px-2 py-0.5 text-[10px] font-medium text-slate-600 border border-slate-200"><%= pluralize(@quizzes.size, 'Test') %> available</span>
  </div>

  <% if @quizzes.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @quizzes.each do |quiz| %>
        <%= link_to material_quiz_path(@material, quiz), class: "group block p-4 rounded-xl border border-slate-200 bg-slate-50 hover:border-slate-900 transition-colors" do %>
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-sm font-semibold text-slate-900 group-hover:text-black transition-colors"><%= quiz.title %></h3>
            <span class="inline-flex items-center justify-center rounded-full bg-slate-900 px-2 py-1 text-[9px] font-semibold text-slate-50 opacity-0 group-hover:opacity-100 transition-opacity">Launch</span>
          </div>
          <div class="flex items-center gap-4 text-[11px] font-medium text-slate-500">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-slate-300 rounded-full"></span>
              <%= quiz.questions.size %> Questions
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-slate-300 rounded-full"></span>
              <%= quiz.generation_mode %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="py-12 flex flex-col items-center justify-center border border-dashed border-slate-200 rounded-xl text-center bg-slate-50">
      <h3 class="text-xs font-semibold text-slate-900 mb-1">No quizzes generated yet</h3>
      <p class="text-[11px] text-slate-600 max-w-xs">Continue your study session to automatically unlock targeted practice tests.</p>
    </div>
  <% end %>
</div>
