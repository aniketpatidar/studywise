<div id="<%= dom_id(material, :quizzes_panel) %>" class="mt-8 bg-[#09090b] border border-[#1f2937] rounded-2xl p-5 sm:p-6 shadow-lg relative overflow-hidden">
  <% quiz_generation_in_progress = local_assigns.fetch(:quiz_generation_in_progress, Study::GenerationTracker.quiz_in_progress?(material.id)) %>
  <% can_generate_quiz = material.notes.any? %>
  <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="text-sm font-semibold text-white">Knowledge Checks</h2>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center rounded-full bg-[#111113] px-2 py-0.5 text-[10px] font-medium border border-[#1f2937]" style="color: #94a3b8;"><%= pluralize(quizzes.size, 'Test') %> available</span>
      <% if can_generate_quiz %>
        <% if quiz_generation_in_progress %>
          <span class="inline-flex items-center rounded-full border border-sky-500/30 bg-sky-500/10 px-2 py-0.5 text-[10px] font-medium" style="color: #7dd3fc;">Generating...</span>
        <% else %>
          <%= button_to (quizzes.any? ? "Generate Another" : "Generate Quiz"), generate_quiz_material_path(material), method: :post, params: { idempotency_key: SecureRandom.uuid }, class: "inline-flex items-center justify-center rounded-full bg-[#bef264] px-3 py-1 text-[10px] font-semibold text-black hover:bg-[#a3e635] transition-colors shadow-[0_0_24px_rgba(190,242,100,0.3)]", data: { turbo_submits_with: "Starting..." } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if quizzes.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% quizzes.each do |quiz| %>
        <%= link_to material_quiz_path(material, quiz), class: "group block p-4 rounded-xl border border-[#1f2937] bg-[#111113] hover:border-[#bef264]/40 transition-colors" do %>
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-sm font-semibold text-white group-hover:text-white transition-colors"><%= quiz.title %></h3>
            <span class="inline-flex items-center justify-center rounded-full bg-[#bef264] px-2 py-1 text-[9px] font-semibold text-black opacity-0 group-hover:opacity-100 transition-opacity">Launch</span>
          </div>
          <div class="flex items-center gap-4 text-[11px] font-medium" style="color: #94a3b8;">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-[#374151] rounded-full"></span>
              <%= quiz.questions.size %> Questions
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-[#374151] rounded-full"></span>
              <%= quiz.generation_mode %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="py-12 flex flex-col items-center justify-center border border-dashed border-[#1f2937] rounded-xl text-center bg-[#111113]">
      <h3 class="text-xs font-semibold text-white mb-1">No quizzes generated yet</h3>
      <p class="text-[11px]" style="color: #94a3b8;">Use `Generate Quiz` to create your first test from this material.</p>
    </div>
  <% end %>
</div>
