<% content_for :title, "Upload Material | StudyWISE" %>

<div class="max-w-4xl mx-auto pb-20">
  <header class="mb-8 sm:mb-10">
    <h1 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">Add new study material</h1>
  </header>

  <section class="mb-6 rounded-2xl border border-[#1f2937] bg-[#09090b] p-5 shadow-lg">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="mt-1 text-sm" style="color: #e2e8f0;">1. Create material 2. Generate note 3. Start quiz or study chat</p>
      </div>
      <%= button_to "Import sample", import_sample_materials_path, method: :post, class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] px-4 py-2 text-xs font-semibold hover:border-[#bef264] hover:text-[#bef264] bg-[#09090b] transition-colors" %>
    </div>
  </section>

  <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-5 sm:p-6 shadow-lg">
    <%= render "form", material: @material %>
  </div>
</div>
