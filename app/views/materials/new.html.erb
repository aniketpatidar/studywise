<% content_for :title, "New Material | StudyWISE" %>

<div class="max-w-3xl mx-auto pb-20 px-4 sm:px-0">
  <header class="mb-10">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-[#2D2E32] mb-4 tracking-tight">Expand Your Library</h1>
    <p class="text-[#6C6D70] font-medium leading-relaxed text-sm sm:text-base">Upload your source files, paste text, or link a YouTube lecture.</p>
  </header>

  <div class="bg-white border border-[#E8E9EB] rounded-[40px] sm:rounded-[48px] p-8 sm:p-14 shadow-2xl shadow-indigo-100/30 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#6C5DD3]/5 rounded-full -mr-32 -mt-32 blur-3xl opacity-60"></div>
    <div class="relative z-10">
      <%= render "form", material: @material %>
    </div>
  </div>
</div>
