<% content_for :title, "Sign up | StudyWISE" %>

<div class="min-h-[calc(100vh-12rem)] flex flex-col items-center justify-center p-6 pb-20">
  <div class="w-full max-w-xl">
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-[#6C5DD3]/10 text-[#6C5DD3] rounded-[24px] sm:rounded-[32px] mb-6 sm:mb-8 animate-pulse">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.143-5.714L5 13l5.714-2.143L13 3z" />
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#2D2E32] mb-3 tracking-tight">Create account</h1>
      <p class="text-[#6C6D70] font-medium leading-relaxed max-w-sm mx-auto text-sm sm:text-base">Build smart notes and practice tests from your own study material.</p>
    </div>

    <div class="bg-white border border-[#E8E9EB] rounded-[40px] sm:rounded-[48px] p-8 sm:p-14 shadow-2xl shadow-indigo-100/40 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-[#6C5DD3]/5 rounded-full -mr-32 -mt-32 blur-3xl opacity-60"></div>
      
      <%= form_with model: @user, url: users_path, class: "relative z-10 space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="p-6 bg-rose-50 border border-rose-100 rounded-[24px] mb-8">
            <div class="flex items-center gap-3 text-rose-700 font-bold mb-3 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Please check the errors:</span>
            </div>
            <ul class="space-y-1 ml-7 text-[10px] text-rose-600 font-bold uppercase tracking-wider list-disc">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-2.5">
          <%= f.label :name, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
          <%= f.text_field :name, required: true, 
              placeholder: "Full Name",
              class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="space-y-2.5">
          <%= f.label :email, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
          <%= f.email_field :email, required: true, 
              placeholder: "email@example.com",
              class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2.5">
            <%= f.label :password, class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
            <%= f.password_field :password, required: true, 
                placeholder: "••••••••",
                class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
            %>
          </div>
          <div class="space-y-2.5">
            <%= f.label :password_confirmation, "Confirm", class: "block text-[10px] sm:text-[11px] font-black uppercase text-[#6C6D70] tracking-widest pl-1" %>
            <%= f.password_field :password_confirmation, required: true, 
                placeholder: "••••••••",
                class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all shadow-sm" 
            %>
          </div>
        </div>

        <div class="pt-6">
          <%= f.submit "Create free account", 
              class: "w-full py-5 bg-[#6C5DD3] text-white rounded-[20px] font-black text-sm tracking-tight hover:bg-[#5849C4] hover:-translate-y-1 transition-all shadow-2xl shadow-indigo-100 cursor-pointer" 
          %>
        </div>
      <% end %>
    </div>

    <p class="mt-8 text-center text-sm font-medium text-[#6C6D70]">
      Already have an account? 
      <%= link_to "Sign in here", login_path, class: "text-[#6C5DD3] font-black hover:underline ml-1" %>
    </p>
  </div>
</div>
