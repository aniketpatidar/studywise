<% content_for :title, "Sign up | StudyWISE" %>

<div class="flex flex-col items-center justify-center px-4 pb-20 bg-slate-50/30">
  <div class="w-full max-w-md sm:max-w-xl">
    <div class="text-center mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2 tracking-tight">Create your account</h1>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-sm relative overflow-hidden">
      <%= form_with model: @user, url: users_path, class: "relative z-10 space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="p-4 sm:p-5 bg-rose-50 border border-rose-100 rounded-2xl mb-6">
            <div class="flex items-center gap-2 text-rose-700 font-semibold mb-2 text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Please fix the following:</span>
            </div>
            <ul class="space-y-1 ml-6 text-[11px] text-rose-600 font-medium list-disc">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-2">
          <%= f.label :name, class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
          <%= f.text_field :name, required: true, 
              placeholder: "Full name",
              class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="space-y-2">
          <%= f.label :email, class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
          <%= f.email_field :email, required: true, 
              placeholder: "you@example.com",
              class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
          %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <%= f.label :password, class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
            <%= f.password_field :password, required: true, 
                placeholder: "Min 6 chars",
                class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
            %>
          </div>
          <div class="space-y-2">
            <%= f.label :password_confirmation, "Confirm", class: "block text-[10px] sm:text-[11px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
            <%= f.password_field :password_confirmation, required: true, 
                placeholder: "Repeat password",
                class: "w-full px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all shadow-sm" 
            %>
          </div>
        </div>

        <div class="pt-4">
          <%= f.submit "Create free StudyWISE account", 
              class: "w-full py-3 bg-slate-900 text-white rounded-full font-semibold text-[13px] tracking-tight hover:bg-black transition-all shadow-sm cursor-pointer" 
          %>
        </div>
      <% end %>
    </div>

    <p class="mt-8 text-center text-sm font-medium text-slate-500">
      Already have an account? 
      <%= link_to "Sign in here", login_path, class: "text-slate-900 font-semibold hover:underline ml-1" %>
    </p>
  </div>
</div>
