<% content_for :title, "LLM Event ##{@event.id} | Admin" %>

<header class="mb-6 flex items-center justify-between gap-3">
  <div>
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Admin</p>
    <h1 class="text-xl sm:text-2xl font-semibold text-slate-900">LLM Event #<%= @event.id %></h1>
  </div>
  <%= link_to admin_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900" do %>
    Back to dashboard
  <% end %>
</header>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm mb-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Operation</p>
      <p class="text-sm font-semibold text-slate-900"><%= @event.operation.to_s.titleize %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Model</p>
      <p class="text-sm font-semibold text-slate-900"><%= @event.model %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Status</p>
      <p class="text-sm font-semibold <%= @event.success ? 'text-emerald-700' : 'text-rose-700' %>"><%= @event.success ? 'Success' : 'Failure' %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Latency</p>
      <p class="text-sm font-semibold text-slate-900"><%= @event.latency_ms || 0 %>ms</p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Prompt chars</p>
      <p class="text-sm font-semibold text-slate-900"><%= number_with_delimiter(@event.prompt_chars) %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Response chars</p>
      <p class="text-sm font-semibold text-slate-900"><%= number_with_delimiter(@event.response_chars) %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">User ID</p>
      <p class="text-sm font-semibold text-slate-900"><%= @event.user_id || '-' %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
      <p class="text-[11px] font-medium text-slate-500 mb-1">Created at</p>
      <p class="text-sm font-semibold text-slate-900"><%= @event.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
    </div>
  </div>

  <% if @event.error_message.present? %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2">
      <p class="text-[11px] font-medium text-rose-700 uppercase tracking-wider mb-1">Error</p>
      <p class="text-sm text-rose-900"><%= @event.error_message %></p>
    </div>
  <% end %>
</section>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-3">Input preview</h2>
    <% if @event.prompt_preview.present? %>
      <pre class="whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-700"><%= @event.prompt_preview %></pre>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4 text-xs text-slate-600">No prompt preview was captured for this event.</div>
    <% end %>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-3">Output preview</h2>
    <% if @event.response_preview.present? %>
      <pre class="whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-700"><%= @event.response_preview %></pre>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4 text-xs text-slate-600">No response preview was captured for this event.</div>
    <% end %>
  </article>
</section>
