<% content_for :title, "LLM Event ##{@event.id} | Admin" %>

<header class="mb-6 flex items-center justify-between gap-3">
  <div>
    <h1 class="text-xl sm:text-2xl font-semibold text-white">LLM Event #<%= @event.id %></h1>
  </div>
  <%= link_to admin_path, class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] px-3 py-1.5 text-xs font-semibold hover:border-[#bef264] hover:text-[#bef264] bg-[#09090b] transition-colors" do %>
    Back
  <% end %>
</header>

<section class="rounded-2xl border border-[#1f2937] bg-[#09090b] p-5 sm:p-6 shadow-lg mb-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Operation</p>
      <p class="text-sm font-semibold text-white"><%= @event.operation.to_s.titleize %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Model</p>
      <p class="text-sm font-semibold text-white"><%= @event.model %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Status</p>
      <p class="text-sm font-semibold <%= @event.success ? 'text-[#bbf7d0]' : 'text-[#fca5a5]' %>"><%= @event.success ? 'Success' : 'Failure' %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Latency</p>
      <p class="text-sm font-semibold text-white"><%= @event.latency_ms || 0 %>ms</p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Prompt chars</p>
      <p class="text-sm font-semibold text-white"><%= number_with_delimiter(@event.prompt_chars) %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Response chars</p>
      <p class="text-sm font-semibold text-white"><%= number_with_delimiter(@event.response_chars) %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">User ID</p>
      <p class="text-sm font-semibold text-white"><%= @event.user_id || '-' %></p>
    </div>
    <div class="rounded-xl border border-[#1f2937] bg-[#111113] px-3 py-3">
      <p class="text-[11px] font-medium mb-1" style="color: #94a3b8;">Created at</p>
      <p class="text-sm font-semibold text-white"><%= @event.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
    </div>
  </div>

  <% if @event.error_message.present? %>
    <div class="mt-4 rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-2">
      <p class="text-[11px] font-medium uppercase tracking-wider mb-1" style="color: #fca5a5;">Error</p>
      <p class="text-sm" style="color: #fca5a5;"><%= @event.error_message %></p>
    </div>
  <% end %>
</section>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <article class="rounded-2xl border border-[#1f2937] bg-[#09090b] p-5 sm:p-6 shadow-lg">
    <h2 class="text-sm font-semibold text-white mb-3">Input</h2>
    <% if @event.prompt_preview.present? %>
      <pre class="whitespace-pre-wrap break-words rounded-xl border border-[#1f2937] bg-[#111113] p-4 text-xs" style="color: #94a3b8;"><%= @event.prompt_preview %></pre>
    <% else %>
      <div class="rounded-xl border border-dashed border-[#1f2937] bg-[#111113] p-4 text-xs" style="color: #94a3b8;">No prompt preview was captured for this event.</div>
    <% end %>
  </article>

  <article class="rounded-2xl border border-[#1f2937] bg-[#09090b] p-5 sm:p-6 shadow-lg">
    <h2 class="text-sm font-semibold text-white mb-3">Output</h2>
    <% if @event.response_preview.present? %>
      <pre class="whitespace-pre-wrap break-words rounded-xl border border-[#1f2937] bg-[#111113] p-4 text-xs" style="color: #94a3b8;"><%= @event.response_preview %></pre>
    <% else %>
      <div class="rounded-xl border border-dashed border-[#1f2937] bg-[#111113] p-4 text-xs" style="color: #94a3b8;">No response preview was captured for this event.</div>
    <% end %>
  </article>
</section>
