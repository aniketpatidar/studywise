<% content_for :title, "Subject Tutors | StudyWISE" %>

<header class="mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
  <div class="max-w-xl">
    <h1 class="text-3xl font-extrabold text-[#2D2E32] tracking-tight">Subject Hub</h1>
    <p class="text-[#6C6D70] font-medium leading-relaxed mt-2 text-sm sm:text-base">Engage in highly targeted expert sessions across core academic domains.</p>
  </div>
  <div class="flex-shrink-0">
    <%= link_to root_path, class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-white border border-[#E8E9EB] rounded-[20px] text-sm font-bold text-[#6C6D70] hover:text-[#2D2E32] hover:border-[#6C5DD3] transition-all shadow-sm w-full sm:w-auto" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Dashboard
    <% end %>
  </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start pb-20">
  <div class="bg-white border border-[#E8E9EB] rounded-[48px] p-8 sm:p-12 shadow-xl shadow-indigo-50/20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#6C5DD3]/5 rounded-full -mr-32 -mt-32 blur-3xl opacity-60"></div>
    
    <div class="relative z-10">
      <div class="flex items-center gap-5 mb-10">
        <div class="w-14 h-14 bg-[#6C5DD3]/10 text-[#6C5DD3] rounded-[24px] flex items-center justify-center text-2xl shadow-sm border border-[#6C5DD3]/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a2 2 0 00-1.96 1.414l-.727 2.903a2 2 0 01-3.664 0l-.727-2.903a2 2 0 00-1.96-1.414l-2.387.477a2 2 0 00-1.022.547l2.146 2.146a2 2 0 01.586 1.414V21" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 7h15M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" />
          </svg>
        </div>
        <div>
          <h2 class="text-2xl font-black text-[#2D2E32] tracking-tight">Initialize Tutor</h2>
          <p class="text-[10px] font-black text-[#6C6D70] uppercase tracking-widest mt-1 opacity-60">Direct Expert Access</p>
        </div>
      </div>

      <%= form_with url: subject_chats_path, method: :post, class: "space-y-8" do |f| %>
        <div class="space-y-3">
          <%= f.label :subject_name, "Target Domain", class: "block text-[9px] font-black uppercase text-[#6C6D70] tracking-[0.2em] pl-1" %>
          <%= f.select :subject_name, @subjects, {}, class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-bold text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all appearance-none cursor-pointer shadow-sm" %>
        </div>
        
        <div class="space-y-3">
          <%= f.label :message, "What are we mastering today?", class: "block text-[9px] font-black uppercase text-[#6C6D70] tracking-[0.2em] pl-1" %>
          <%= f.text_area :message, rows: 4, required: true, 
              placeholder: "e.g. Can you explain the process of Mitosis and its significance in cellular growth?", 
              class: "w-full px-6 py-4 bg-gray-50 border border-[#E8E9EB] rounded-2xl text-sm font-medium text-[#2D2E32] focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 transition-all resize-none placeholder:text-[#B1B5C3] shadow-sm h-40" 
          %>
        </div>

        <%= f.submit "Launch Session", class: "w-full py-5 bg-[#6C5DD3] text-white rounded-[24px] font-black text-sm tracking-tight hover:bg-[#5849C4] hover:-translate-y-1 transition-all shadow-2xl shadow-indigo-100 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="bg-gray-50/50 border border-[#E8E9EB] rounded-[48px] p-8 sm:p-12 relative overflow-hidden">
    <div class="flex items-center justify-between mb-10">
      <div>
        <h2 class="text-2xl font-black text-[#2D2E32] tracking-tight">Expert History</h2>
        <p class="text-[10px] font-black text-[#6C6D70] uppercase tracking-widest mt-1">Previous Engagements</p>
      </div>
      <span class="px-3 py-1 bg-white border border-[#E8E9EB] rounded-full text-[10px] font-black uppercase text-[#6C6D70] tracking-widest"><%= @sessions.size %> Active</span>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-4 max-h-[600px] overflow-y-auto pr-3 custom-scrollbar">
        <% @sessions.each do |session| %>
          <%= link_to subject_chat_path(session), class: "group block bg-white border border-[#E8E9EB] rounded-[32px] p-6 transition-all hover:border-[#6C5DD3] hover:shadow-xl hover:shadow-indigo-50/40" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-5">
                <div class="w-12 h-12 bg-gray-50 group-hover:bg-indigo-50 border border-[#E8E9EB] group-hover:border-indigo-100 rounded-[20px] flex items-center justify-center text-xl transition-all group-hover:scale-110 text-[#6C5DD3]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="font-black text-[#2D2E32] group-hover:text-[#6C5DD3] transition-colors truncate tracking-tight"><%= session.title.presence || session.subject_name %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-[9px] font-black uppercase text-[#6C6D70] tracking-widest"><%= session.updated_at.strftime("%b %d, %Y") %></span>
                    <span class="w-1 h-1 bg-[#E8E9EB] rounded-full"></span>
                    <span class="text-[9px] font-black uppercase text-emerald-500 tracking-widest">Resumable</span>
                  </div>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#E8E9EB] group-hover:text-[#6C5DD3] transition-all transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="py-20 flex flex-col items-center justify-center border-2 border-dashed border-[#E8E9EB] rounded-[40px] text-center bg-white/50">
        <div class="w-16 h-16 bg-white border border-[#F1F2F4] rounded-[24px] flex items-center justify-center text-3xl mb-6 grayscale opacity-40 shadow-sm text-[#6C5DD3]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="text-xl font-extrabold text-[#2D2E32] mb-2 tracking-tight">No session history</h3>
        <p class="text-[#6C6D70] text-sm max-w-xs leading-relaxed font-medium px-6">Select a domain and initialize your first expert session above.</p>
      </div>
    <% end %>
  </div>
</div>
