<% content_for :title, "Subject Tutors | StudyWISE" %>

<header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
  <div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">Tutor Hub</h1>
  </div>
  <div class="flex-shrink-0">
    <%= link_to root_path, class: "inline-flex items-center justify-center gap-2 rounded-full border border-[#1f2937] px-4 py-2 text-xs font-semibold hover:border-[#bef264] hover:text-[#bef264] bg-[#09090b] transition-colors w-full sm:w-auto" do %>
      <span>Back</span>
    <% end %>
  </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start pb-20">
  <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-6 sm:p-10 shadow-lg">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-12 h-12 bg-[#111113] border border-[#1f2937] rounded-xl flex items-center justify-center" style="color: #94a3b8;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a2 2 0 00-1.96 1.414l-.727 2.903a2 2 0 01-3.664 0l-.727-2.903a2 2 0 00-1.96-1.414l-2.387.477a2 2 0 00-1.022.547l2.146 2.146a2 2 0 01.586 1.414V21" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 7h15M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" />
        </svg>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white tracking-tight">Tutor</h2>
      </div>
    </div>

    <%= form_with url: subject_chats_path, method: :post, class: "space-y-6" do |f| %>
      <div class="space-y-2">
        <%= f.label :subject_name, "Subject", class: "block text-[10px] font-semibold uppercase tracking-wider pl-1", style: "color: #94a3b8;" %>
        <%= f.select :subject_name, @subjects, {}, class: "w-full px-4 py-3 bg-[#111113] border border-[#374151] rounded-xl text-sm font-semibold focus:outline-none focus:border-[#bef264] focus:ring-4 focus:ring-[#bef264]/20 transition-all appearance-none cursor-pointer", style: "color: #ffffff;" %>
      </div>

      <div class="space-y-2">
        <%= f.label :message, "What are we mastering today?", class: "block text-[10px] font-semibold uppercase tracking-wider pl-1", style: "color: #94a3b8;" %>
        <%= f.text_area :message, rows: 4, required: true,
            placeholder: "e.g. Can you explain the process of Mitosis and its significance in cellular growth?",
            class: "w-full px-4 py-3 bg-[#111113] border border-[#374151] rounded-xl text-sm font-medium placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-4 focus:ring-[#bef264]/20 transition-all resize-none shadow-sm h-32",
            style: "color: #ffffff;"
        %>
      </div>

      <%= f.submit "Launch Session", class: "w-full py-3 bg-[#bef264] text-black rounded-full font-semibold text-xs tracking-tight hover:bg-[#a3e635] transition-all cursor-pointer shadow-[0_0_24px_rgba(190,242,100,0.3)]" %>
    <% end %>
  </div>

  <div class="bg-[#09090b] border border-[#1f2937] rounded-2xl p-6 sm:p-10 shadow-lg">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl font-semibold text-white tracking-tight">Expert History</h2>
        <p class="text-[10px] font-medium uppercase tracking-wider mt-0.5" style="color: #94a3b8;">Previous Engagements</p>
      </div>
      <span class="px-2.5 py-1 bg-[#111113] border border-[#1f2937] rounded-full text-[10px] font-semibold" style="color: #94a3b8;"><%= @sessions.size %> Active</span>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-3 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
        <% @sessions.each do |session| %>
          <%= link_to subject_chat_path(session), class: "group block bg-[#111113] border border-[#1f2937] rounded-xl p-4 transition-all hover:border-[#bef264]/40" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-[#09090b] border border-[#1f2937] rounded-lg flex items-center justify-center transition-all" style="color: #94a3b8;">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-white transition-colors truncate"><%= session.title.presence || session.subject_name %></h3>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider" style="color: #94a3b8;"><%= session.updated_at.strftime("%b %d, %Y") %></span>
                  </div>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:text-[#bef264] transition-all transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #374151;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 flex flex-col items-center justify-center border border-dashed border-[#1f2937] rounded-xl text-center bg-[#111113]">
        <div class="w-12 h-12 bg-[#09090b] border border-[#1f2937] rounded-lg flex items-center justify-center mb-6" style="color: #374151;">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-1">No session history</h3>
      </div>
    <% end %>
  </div>
</div>
