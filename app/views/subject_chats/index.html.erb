<% content_for :title, "Subject Tutors | StudyWISE" %>

<header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
  <div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">Subject Hub</h1>
    <p class="mt-1 text-sm text-slate-600">Engage in highly targeted expert sessions across core academic domains.</p>
  </div>
  <div class="flex-shrink-0">
    <%= link_to root_path, class: "inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 w-full sm:w-auto" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Dashboard</span>
    <% end %>
  </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start pb-20">
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-12 h-12 bg-slate-50 text-slate-600 rounded-xl flex items-center justify-center border border-slate-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a2 2 0 00-1.96 1.414l-.727 2.903a2 2 0 01-3.664 0l-.727-2.903a2 2 0 00-1.96-1.414l-2.387.477a2 2 0 00-1.022.547l2.146 2.146a2 2 0 01.586 1.414V21" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 7h15M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" />
        </svg>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-slate-900 tracking-tight">Initialize Tutor</h2>
        <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mt-0.5">Direct Expert Access</p>
      </div>
    </div>

    <%= form_with url: subject_chats_path, method: :post, class: "space-y-6" do |f| %>
      <div class="space-y-2">
        <%= f.label :subject_name, "Target Domain", class: "block text-[10px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
        <%= f.select :subject_name, @subjects, {}, class: "w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all appearance-none cursor-pointer" %>
      </div>
      
      <div class="space-y-2">
        <%= f.label :message, "What are we mastering today?", class: "block text-[10px] font-semibold uppercase text-slate-500 tracking-wider pl-1" %>
        <%= f.text_area :message, rows: 4, required: true, 
            placeholder: "e.g. Can you explain the process of Mitosis and its significance in cellular growth?", 
            class: "w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all resize-none shadow-sm h-32" 
        %>
      </div>

      <%= f.submit "Launch Session", class: "w-full py-3 bg-slate-900 text-white rounded-full font-semibold text-xs tracking-tight hover:bg-black transition-all cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-slate-50/50 border border-slate-200 rounded-2xl p-6 sm:p-10">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl font-semibold text-slate-900 tracking-tight">Expert History</h2>
        <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mt-0.5">Previous Engagements</p>
      </div>
      <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-full text-[10px] font-semibold text-slate-500"><%= @sessions.size %> Active</span>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-3 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
        <% @sessions.each do |session| %>
          <%= link_to subject_chat_path(session), class: "group block bg-white border border-slate-200 rounded-xl p-4 transition-all hover:border-slate-900 hover:shadow-sm" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-slate-50 group-hover:bg-slate-900 border border-slate-100 group-hover:border-slate-900 rounded-lg flex items-center justify-center transition-all text-slate-400 group-hover:text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-slate-900 transition-colors truncate"><%= session.title.presence || session.subject_name %></h3>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wider"><%= session.updated_at.strftime("%b %d, %Y") %></span>
                    <span class="w-1 h-1 bg-slate-200 rounded-full"></span>
                    <span class="text-[10px] font-semibold text-emerald-600 uppercase tracking-wider">Resumable</span>
                  </div>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-slate-900 transition-all transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 flex flex-col items-center justify-center border border-dashed border-slate-200 rounded-xl text-center bg-white">
        <div class="w-12 h-12 bg-slate-50 border border-slate-100 rounded-lg flex items-center justify-center text-slate-300 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-slate-900 mb-1">No session history</h3>
        <p class="text-slate-500 text-xs max-w-xs leading-relaxed px-6">Select a domain and initialize your first expert session above.</p>
      </div>
    <% end %>
  </div>
</div>
