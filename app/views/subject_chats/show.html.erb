<% content_for :title, "#{@chat_session.subject_name} Tutor | StudyWISE" %>

<div class="h-[calc(100vh-12rem)] lg:h-[calc(100vh-8rem)] max-w-5xl mx-auto flex flex-col bg-[#09090b] border border-[#1f2937] sm:rounded-3xl shadow-lg overflow-hidden mb-4">
  <div class="px-6 sm:px-8 py-5 border-b border-[#1f2937] bg-[#111113]">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-medium tracking-wider uppercase" style="color: #94a3b8;">Expert Session</p>
        <h1 class="text-lg sm:text-xl font-semibold text-white leading-snug truncate"><%= @chat_session.subject_name %> Tutor</h1>
      </div>
      <div class="hidden sm:flex items-center gap-2 flex-shrink-0">
        <%= link_to subject_chats_path, class: "inline-flex items-center justify-center rounded-full border border-[#1f2937] bg-[#09090b] px-3 py-1.5 text-[11px] font-semibold hover:border-[#bef264] hover:text-[#bef264] shadow-sm transition" do %>
          All sessions
        <% end %>
      </div>
    </div>

    <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#111113] border border-[#1f2937] px-3 py-1.5 text-[10px] font-semibold shadow-sm" style="color: #94a3b8;">
      <span class="h-1.5 w-1.5 rounded-full bg-[#bef264]"></span>
      Live expert session
      <span class="mx-1.5 h-1 w-1 rounded-full bg-[#1f2937]"></span>
      <span>Context saved automatically</span>
    </div>
  </div>

  <div class="flex-grow overflow-y-auto px-6 sm:px-8 py-6 space-y-5 scroll-smooth custom-scrollbar" id="chat-bubbles">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-[90%] sm:max-w-[80%] flex items-start gap-3 <%= message.role == 'user' ? 'flex-row-reverse' : '' %>">
            <div class="w-7 h-7 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-[10px] font-semibold <%= message.role == 'user' ? 'bg-[#bef264] text-black' : 'bg-[#111113] border border-[#1f2937]' %>" style="<%= message.role != 'user' ? 'color: #94a3b8;' : '' %>">
              <% if message.role == 'user' %>
                <%= current_user.name.first.upcase %>
              <% else %>
                AI
              <% end %>
            </div>
            <div class="<%= message.role == 'user' ? 'bg-[#bef264] text-black rounded-2xl rounded-tr-none' : 'bg-[#111113] rounded-2xl rounded-tl-none border border-[#1f2937]' %> px-4 py-3 shadow-sm">
              <div class="prose prose-sm <%= message.role == 'user' ? 'prose-invert' : '' %> max-w-none text-xs sm:text-sm font-medium leading-relaxed">
                <%= message.content %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div id="chat-empty-state" class="h-full flex flex-col items-center justify-center text-center max-w-md mx-auto px-4">
        <div class="w-12 h-12 bg-[#111113] border border-[#1f2937] rounded-xl mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #94a3b8;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-white mb-2">Ask your first expert question</h2>
        <p class="mb-8 leading-relaxed text-xs" style="color: #94a3b8;">
          Your <%= @chat_session.subject_name %> tutor can break down concepts, walk through examples, and create practice prompts.
        </p>
      </div>
    <% end %>
  </div>

  <div class="px-6 sm:px-8 py-5 border-t border-[#1f2937] bg-[#111113]">
    <p id="chat-pending-state" class="hidden mb-2 text-[11px] font-medium" style="color: #94a3b8;">Generating response...</p>
    <%= form_with url: subject_chats_path, method: :post, id: "chat-compose-form", data: { stream_url: stream_subject_chat_path(@chat_session) }, class: "flex items-center gap-2" do |f| %>
      <%= f.hidden_field :subject_name, value: @chat_session.subject_name %>
      <%= f.text_field :message,
          placeholder: "Ask something specific...",
          required: true,
          id: "chat-input",
          class: "w-full px-4 py-3 bg-[#09090b] border border-[#374151] rounded-2xl text-sm font-medium placeholder-[#94a3b8] focus:outline-none focus:border-[#bef264] focus:ring-4 focus:ring-[#bef264]/20 transition-all shadow-sm",
          style: "color: #ffffff;"
      %>
      <button id="chat-send-button" type="submit" class="rounded-xl bg-[#bef264] text-black hover:bg-[#a3e635] transition-all flex items-center justify-center shadow-md shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" style="width: 2.5rem; height: 2.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 11.5l14-6.5-6.5 14-1.5-5-5-1.5z" />
        </svg>
      </button>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chatLog = document.getElementById('chat-bubbles');
    if (chatLog) {
      chatLog.scrollTop = chatLog.scrollHeight;
    }

    const composeForm = document.getElementById('chat-compose-form');
    const pendingState = document.getElementById('chat-pending-state');
    const input = document.getElementById('chat-input');
    const sendButton = document.getElementById('chat-send-button');
    const emptyState = document.getElementById('chat-empty-state');

    if (composeForm && pendingState && input && sendButton) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

      const appendBubble = (role, content) => {
        const wrapper = document.createElement('div');
        wrapper.className = "flex " + (role === "user" ? "justify-end" : "justify-start");

        const row = document.createElement('div');
        row.className = "max-w-[90%] sm:max-w-[80%] flex items-start gap-3 " + (role === "user" ? "flex-row-reverse" : "");

        const avatar = document.createElement('div');
        avatar.className = "w-7 h-7 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-[10px] font-semibold " +
          (role === "user" ? "bg-[#bef264] text-black" : "bg-[#111113] border border-[#1f2937]");
        avatar.style.color = role === "user" ? "#000" : "#94a3b8";
        avatar.textContent = role === "user" ? "You" : "AI";

        const bubble = document.createElement('div');
        bubble.className = (role === "user"
          ? "bg-[#bef264] text-black rounded-2xl rounded-tr-none"
          : "bg-[#111113] rounded-2xl rounded-tl-none border border-[#1f2937]") + " px-4 py-3 shadow-sm";

        const text = document.createElement('div');
        text.className = "whitespace-pre-wrap text-xs sm:text-sm font-medium leading-relaxed";
        text.style.color = role === "user" ? "#000" : "#e2e8f0";
        text.textContent = content || "";

        bubble.appendChild(text);
        row.appendChild(avatar);
        row.appendChild(bubble);
        wrapper.appendChild(row);
        chatLog.appendChild(wrapper);
        chatLog.scrollTop = chatLog.scrollHeight;
        return text;
      };

      const parseSseBlocks = (buffer, onEvent) => {
        let remaining = buffer;
        while (true) {
          const splitAt = remaining.indexOf("\n\n");
          if (splitAt === -1) break;
          const block = remaining.slice(0, splitAt);
          remaining = remaining.slice(splitAt + 2);
          const data = block
            .split("\n")
            .filter((line) => line.startsWith("data:"))
            .map((line) => line.replace(/^data:\s?/, ""))
            .join("\n");
          if (!data) continue;
          try {
            onEvent(JSON.parse(data));
          } catch (_e) {
          }
        }
        return remaining;
      };

      composeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const streamUrl = composeForm.dataset.streamUrl;
        const message = input.value.trim();
        if (!message || !streamUrl) return;

        pendingState.classList.remove('hidden');
        input.setAttribute('readonly', 'readonly');
        sendButton.disabled = true;
        if (emptyState) emptyState.classList.add("hidden");

        appendBubble("user", message);
        const assistantTextNode = appendBubble("assistant", "");
        let assistantContent = "";

        try {
          const formData = new FormData(composeForm);
          formData.set("message", message);

          const response = await fetch(streamUrl, {
            method: "POST",
            headers: {
              "Accept": "text/event-stream",
              "X-CSRF-Token": csrfToken || ""
            },
            body: formData
          });

          if (!response.ok || !response.body) {
            throw new Error("Streaming request failed.");
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = "";

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            buffer = parseSseBlocks(buffer, (payload) => {
              if (payload.type === "chunk" && payload.content) {
                assistantContent += payload.content;
                assistantTextNode.textContent = assistantContent;
                chatLog.scrollTop = chatLog.scrollHeight;
              }
            });
          }

          input.value = "";
        } catch (_error) {
          assistantTextNode.textContent = "Response failed while streaming. Please retry.";
        } finally {
          pendingState.classList.add('hidden');
          input.removeAttribute('readonly');
          sendButton.disabled = false;
          input.focus();
        }
      });
    }
  })();
</script>
