<% content_for :title, "#{@chat_session.subject_name} Tutor | StudyWISE" %>

<div class="h-[calc(100vh-12rem)] lg:h-[calc(100vh-8rem)] max-w-5xl mx-auto flex flex-col bg-white border border-slate-200 sm:rounded-3xl shadow-sm overflow-hidden mb-4">
  <div class="px-6 sm:px-8 py-5 border-b border-slate-100 bg-slate-50/50">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-medium tracking-wider uppercase text-slate-500 mb-1">Expert Session</p>
        <h1 class="text-lg sm:text-xl font-semibold text-slate-900 leading-snug truncate"><%= @chat_session.subject_name %> Tutor</h1>
        <p class="mt-1 text-xs text-slate-500">
          Direct expert-style guidance for this subject. Ask follow ups, examples, and exam-style questions.
        </p>
      </div>
      <div class="hidden sm:flex items-center gap-2 flex-shrink-0">
        <%= link_to subject_chats_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 shadow-sm transition" do %>
          All sessions
        <% end %>
      </div>
    </div>

    <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-3 py-1.5 text-[10px] font-semibold text-slate-500 shadow-sm">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      Live expert session
      <span class="mx-1.5 h-1 w-1 rounded-full bg-slate-200"></span>
      <span>Context saved automatically</span>
    </div>
  </div>
  
  <div class="flex-grow overflow-y-auto px-6 sm:px-8 py-6 space-y-5 scroll-smooth custom-scrollbar" id="chat-bubbles">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-[90%] sm:max-w-[80%] flex items-start gap-3 <%= message.role == 'user' ? 'flex-row-reverse' : '' %>">
            <div class="w-7 h-7 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-[10px] font-semibold <%= message.role == 'user' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 border border-slate-200' %>">
              <% if message.role == 'user' %>
                <%= current_user.name.first.upcase %>
              <% else %>
                AI
              <% end %>
            </div>
            <div class="<%= message.role == 'user' ? 'bg-slate-900 text-white rounded-2xl rounded-tr-none' : 'bg-slate-50 text-slate-900 rounded-2xl rounded-tl-none border border-slate-200' %> px-4 py-3 shadow-sm">
              <div class="prose prose-sm <%= message.role == 'user' ? 'prose-invert' : '' %> max-w-none text-xs sm:text-sm font-medium leading-relaxed">
                <%= message.content %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="h-full flex flex-col items-center justify-center text-center max-w-md mx-auto px-4">
        <div class="w-12 h-12 bg-slate-100 text-slate-400 flex items-center justify-center rounded-xl mb-6 border border-slate-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-900 mb-2">Ask your first expert question</h2>
        <p class="text-slate-500 mb-8 leading-relaxed text-xs">
          Your <%= @chat_session.subject_name %> tutor can break down concepts, walk through examples, and create practice prompts.
        </p>
      </div>
    <% end %>
  </div>

  <div class="px-6 sm:px-8 py-5 border-t border-slate-100 bg-slate-50/30">
    <%= form_with url: subject_chats_path, method: :post, class: "relative group" do |f| %>
      <%= f.hidden_field :subject_name, value: @chat_session.subject_name %>
      <%= f.text_area :message, 
          placeholder: "Ask something specific...", 
          required: true, 
          rows: 1,
          id: "chat-input",
          class: "w-full pl-5 pr-14 py-3 bg-white border border-slate-200 rounded-2xl text-sm font-medium text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-4 focus:ring-slate-900/5 transition-all resize-none shadow-sm" 
      %>
      <button type="submit" class="absolute right-2 bottom-2 w-9 h-9 rounded-xl bg-slate-900 text-white hover:bg-black transition-all flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 11.5l14-6.5-6.5 14-1.5-5-5-1.5z" />
        </svg>
      </button>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chatLog = document.getElementById('chat-bubbles');
    if (chatLog) {
      chatLog.scrollTop = chatLog.scrollHeight;
    }
    
    const textarea = document.getElementById('chat-input');
    if (textarea) {
      textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
        if (chatLog) chatLog.scrollTop = chatLog.scrollHeight;
      });
    }
  })();
</script>
