<% content_for :title, "#{@chat_session.subject_name} Tutor | StudyWISE" %>

<div class="h-[calc(100vh-12rem)] lg:h-[calc(100vh-8rem)] max-w-5xl mx-auto flex flex-col bg-white border border-[#E8E9EB] sm:rounded-[40px] shadow-sm overflow-hidden mb-4">
  <div class="flex items-center justify-between px-6 sm:px-10 py-4 sm:py-6 border-b border-[#E8E9EB] bg-gray-50/50">
    <div class="flex items-center gap-3 sm:gap-4 overflow-hidden">
      <div class="w-8 h-8 sm:w-10 sm:h-10 bg-[#6C5DD3] rounded-xl sm:rounded-2xl flex items-center justify-center text-white text-base sm:text-lg flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 14l9-5-9-5-9 5 9 5z" />
          <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
        </svg>
      </div>
      <div class="min-w-0">
        <h1 class="text-base sm:text-xl font-extrabold text-[#2D2E32] truncate"><%= @chat_session.subject_name %> Tutor</h1>
        <p class="text-[9px] sm:text-[10px] font-bold text-[#6C6D70] uppercase tracking-widest flex items-center gap-2 truncate">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full flex-shrink-0"></span>
          <span class="truncate">Direct Expert Session</span>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= link_to subject_chats_path, class: "p-2 sm:p-2.5 border border-[#E8E9EB] rounded-lg sm:rounded-xl text-[#6C6D70] hover:bg-white hover:text-[#2D2E32] transition-all shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="flex-grow overflow-y-auto px-6 sm:px-10 py-6 sm:py-10 space-y-6 sm:space-y-8 scroll-smooth custom-scrollbar" id="chat-bubbles">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-[90%] sm:max-w-[80%] flex items-start gap-3 sm:gap-4 <%= message.role == 'user' ? 'flex-row-reverse' : '' %>">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full shadow-sm flex-shrink-0 flex items-center justify-center text-xs sm:text-sm <%= message.role == 'user' ? 'bg-[#6C5DD3] text-white' : 'bg-white border border-[#E8E9EB]' %>">
              <% if message.role == 'user' %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              <% end %>
            </div>
            <div class="<%= message.role == 'user' ? 'bg-[#6C5DD3] text-white rounded-t-[20px] rounded-bl-[20px] sm:rounded-t-[24px] sm:rounded-bl-[24px]' : 'bg-gray-100/80 text-[#2D2E32] rounded-t-[20px] rounded-br-[20px] sm:rounded-t-[24px] sm:rounded-br-[24px]' %> px-4 sm:px-6 py-3 sm:py-4 shadow-sm">
              <div class="prose prose-sm <%= message.role == 'user' ? 'prose-invert' : '' %> max-w-none text-xs sm:text-sm font-medium leading-relaxed">
                <%= message.content %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="h-full flex flex-col items-center justify-center text-center max-w-md mx-auto px-4">
        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-emerald-50 text-[#6C5DD3] flex items-center justify-center rounded-[24px] sm:rounded-[32px] mb-6 sm:mb-8 grayscale opacity-50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#2D2E32] mb-3 text-balance">Ask your first question!</h2>
        <p class="text-[#6C6D70] mb-8 sm:mb-10 leading-relaxed font-medium text-sm sm:text-base text-balance">Your <%= @chat_session.subject_name %> expert is ready to help you master this topic.</p>
      </div>
    <% end %>
  </div>

  <div class="px-6 sm:px-10 py-6 sm:py-8 border-t border-[#E8E9EB] bg-gray-50/50">
    <%= form_with url: subject_chats_path, method: :post, class: "relative group" do |f| %>
      <%= f.hidden_field :subject_name, value: @chat_session.subject_name %>
      <%= f.text_area :message, 
          placeholder: "Ask an expert question...", 
          required: true, 
          rows: 1,
          class: "w-full pl-5 pr-14 sm:pl-6 sm:pr-16 py-3 sm:py-4 bg-white border border-[#E8E9EB] rounded-xl sm:rounded-2xl text-xs sm:text-sm font-medium focus:outline-none focus:border-[#6C5DD3] focus:ring-4 focus:ring-[#6C5DD3]/5 placeholder:text-[#B1B5C3] transition-all resize-none shadow-sm group-focus-within:shadow-md" 
      %>
      <button type="submit" class="absolute right-2 sm:right-3 bottom-2 sm:bottom-2.5 w-10 h-10 sm:w-11 sm:h-11 bg-[#6C5DD3] text-white rounded-lg sm:rounded-xl hover:bg-[#5849C4] transition-all flex items-center justify-center shadow-lg shadow-indigo-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chatLog = document.getElementById('chat-bubbles');
    if (chatLog) {
      chatLog.scrollTop = chatLog.scrollHeight;
    }
    
    const textarea = document.querySelector('textarea');
    if (textarea) {
      textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
        if (chatLog) chatLog.scrollTop = chatLog.scrollHeight;
      });
    }
  })();
</script>
