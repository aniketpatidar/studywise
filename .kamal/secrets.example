# Copy this file to .kamal/secrets and set real values before deploy.
# Do not commit .kamal/secrets.

# Docker registry auth for Kamal image pushes
KAMAL_REGISTRY_PASSWORD=replace_me

# Rails app secrets
RAILS_MASTER_KEY=$(cat config/master.key)
STUDYWISE_DATABASE_PASSWORD=replace_me
GEMINI_API_KEY=replace_me
YOUTUBE_API_KEY=replace_me
